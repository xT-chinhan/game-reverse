<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/sdm_myoffer_bg_rv_double_retention_card"
    android:paddingTop="36dp"
    android:paddingBottom="28dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">
    <TextView
        android:textSize="17sp"
        android:textColor="#ff000000"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/sdm_myoffer_rv_double_retention_tv_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="6"
        android:includeFontPadding="false"
        android:lineSpacingMultiplier="1.15"
        android:fontFamily="sans-serif-medium"/>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#ffffffff"
        android:gravity="center"
        android:id="@+id/sdm_myoffer_rv_double_retention_btn_accept"
        android:background="@drawable/sdm_myoffer_bg_rv_double_retention_primary_btn"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="24dp"
        android:includeFontPadding="false"
        android:fontFamily="sans-serif-medium"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#ff999999"
        android:gravity="center"
        android:id="@+id/sdm_myoffer_rv_double_retention_tv_reject"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:minHeight="48dp"
        android:fontFamily="sans-serif"/>
</LinearLayout>

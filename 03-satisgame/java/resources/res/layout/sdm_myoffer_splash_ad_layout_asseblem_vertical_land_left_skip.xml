<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.smartdigimkt.sdk.basead.ui.component.RoundImageView
            android:id="@+id/sdm_myoffer_splash_bg"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/sdm_splash_1001_assembly_land_content_inset_top"
            android:scaleType="centerCrop"/>
        <FrameLayout
            android:id="@+id/sdm_myoffer_splash_ad_content_image_area"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/sdm_splash_1001_assembly_land_content_inset_top"/>
        <com.smartdigimkt.sdk.basead.ui.PlayerView
            android:id="@+id/sdm_myoffer_player_view_id"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/sdm_splash_1001_assembly_land_content_inset_top"/>
        <com.smartdigimkt.sdk.basead.ui.MuteImageView
            android:id="@+id/sdm_myoffer_btn_mute_id"
            android:background="@drawable/sdm_myoffer_video_mute_icon"
            android:visibility="gone"
            android:layout_width="@dimen/sdm_myoffer_half_screen_button_size"
            android:layout_height="@dimen/sdm_myoffer_half_screen_button_size"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="@dimen/sdm_splash_1001_top_chrome_margin_land"
            android:layout_marginRight="-12dp"/>
        <include
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="@dimen/sdm_splash_1001_top_chrome_margin_land"
            android:layout_toRightOf="@+id/sdm_myoffer_btn_mute_id"
            layout="@layout/sdm_myoffer_feedback_button"/>
        <ImageView
            android:id="@+id/sdm_myoffer_player_view_cover_img_id"
            android:background="#fafafa"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/sdm_splash_1001_assembly_land_content_inset_top"
            android:scaleType="centerCrop"/>
        <ImageView
            android:id="@+id/sdm_myoffer_player_view_cover_icon_id"
            android:visibility="gone"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/sdm_player_view_placeholder_icon"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <include
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignTop="@+id/sdm_myoffer_splash_skip_area"
        android:layout_alignBottom="@+id/sdm_myoffer_splash_skip_area"
        layout="@layout/sdm_myoffer_include_splash_ad_layout_ad_label"/>
    <include layout="@layout/sdm_myoffer_include_guide2click_mask"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/sdm_myoffer_splash_ad_cta_layout"
        android:background="@drawable/sdm_myoffer_bg_splash_card_cta"
        android:paddingLeft="20dp"
        android:paddingTop="20dp"
        android:paddingRight="20dp"
        android:paddingBottom="20dp"
        android:layout_width="332dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="96dp"
        android:minHeight="72dp"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true">
        <TextView
            android:textSize="17sp"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:id="@+id/sdm_myoffer_splash_cta_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="2dp"
            android:lineSpacingMultiplier="1"
            android:textAlignment="center"/>
        <com.smartdigimkt.sdk.basead.ui.SplashShakeTextHintView
            android:id="@+id/sdm_myoffer_splash_cta_shake"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <com.smartdigimkt.sdk.basead.ui.CloseFrameLayout
        android:id="@+id/sdm_myoffer_splash_enter_immediately_area"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sdm_splash_1001_top_chrome_margin_land"
        android:layout_marginRight="12dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/sdm_myoffer_splash_enter_immediately_row"
            android:background="@drawable/sdm_myoffer_bg_splash_enter_immediately"
            android:paddingLeft="4dp"
            android:paddingTop="4dp"
            android:paddingRight="12dp"
            android:paddingBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.smartdigimkt.sdk.basead.ui.component.RoundImageView
                android:id="@+id/sdm_myoffer_splash_enter_immediately_icon"
                android:visibility="gone"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginRight="4dp"
                android:scaleType="centerCrop"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#ffffffff"
                android:gravity="center_vertical"
                android:id="@+id/sdm_myoffer_splash_enter_immediately"
                android:background="@null"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="24dp"
                android:text="@string/sdm_myoffer_splash_enter_immediately"
                android:includeFontPadding="false"/>
        </LinearLayout>
    </com.smartdigimkt.sdk.basead.ui.CloseFrameLayout>
    <RelativeLayout
        android:id="@+id/sdm_myoffer_splash_ad_bottom_container"
        android:background="@drawable/sdm_myoffer_splash_bg_info"
        android:paddingTop="40dp"
        android:layout_width="match_parent"
        android:layout_height="116dp"
        android:layout_marginBottom="12dp"
        android:layout_above="@+id/sdm_myoffer_splash_skip_area">
        <com.smartdigimkt.sdk.basead.ui.component.RoundImageView
            android:id="@+id/sdm_myoffer_splash_icon"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginLeft="24dp"
            android:layout_marginRight="12dp"
            android:scaleType="centerCrop"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:id="@+id/sdm_myoffer_ll_title_desc_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-3dp"
            android:layout_marginRight="24dp"
            android:layout_toRightOf="@+id/sdm_myoffer_splash_icon"
            android:layout_alignTop="@+id/sdm_myoffer_splash_icon"
            android:layout_alignBottom="@+id/sdm_myoffer_splash_icon">
            <TextView
                android:textSize="17dp"
                android:textColor="#ffffff"
                android:ellipsize="end"
                android:id="@+id/sdm_myoffer_splash_ad_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:lineSpacingMultiplier="1"/>
            <TextView
                android:textSize="12dp"
                android:textColor="#ffffff"
                android:ellipsize="end"
                android:id="@+id/sdm_myoffer_splash_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="1"
                android:lineSpacingMultiplier="1"/>
        </LinearLayout>
        <include
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_marginRight="24dp"
            android:layout_alignBottom="@+id/sdm_myoffer_splash_icon"
            android:layout_alignParentRight="true"
            layout="@layout/sdm_myoffer_include_invalid_button"/>
    </RelativeLayout>
    <include
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:layout_alignParentBottom="true"
        layout="@layout/sdm_myoffer_include_4_element"/>
    <include layout="@layout/sdm_myoffer_include_guide2click_container"/>
    <include
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginBottom="32dp"
        android:layout_alignParentLeft="true"
        android:layout_alignParentBottom="true"
        layout="@layout/sdm_myoffer_include_splash_ad_layout_skip_area"/>
</merge>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:focusable="false"
    android:clickable="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/sdm_swipe_interaction_host"
        android:clickable="false"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:layout_gravity="center"
            android:id="@+id/sdm_swipe_stack_horizontal"
            android:visibility="gone"
            android:clipChildren="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/sdm_swipe_arrow_horizontal_full"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/sdm_interaction_arrow_hor"
                android:scaleType="fitCenter"
                android:contentDescription="@null"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/sdm_swipe_finger_horizontal"
                android:clickable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="30dp"
                android:src="@drawable/sdm_interaction_gesture"
                android:scaleType="fitCenter"
                android:contentDescription="@null"/>
        </FrameLayout>
        <FrameLayout
            android:layout_gravity="center"
            android:id="@+id/sdm_swipe_stack_vertical"
            android:visibility="gone"
            android:clipChildren="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/sdm_swipe_arrow_vertical_full"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/sdm_interaction_arrow_up"
                android:scaleType="fitCenter"
                android:contentDescription="@null"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/sdm_swipe_finger_vertical"
                android:clickable="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="50dp"
                android:src="@drawable/sdm_interaction_gesture"
                android:scaleType="fitCenter"
                android:contentDescription="@null"/>
        </FrameLayout>
        <FrameLayout
            android:layout_gravity="center"
            android:id="@+id/sdm_swipe_stack_cross"
            android:visibility="visible"
            android:clipChildren="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/sdm_swipe_cross_horizontal_full"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/sdm_interaction_arrow_hor"
                android:scaleType="fitCenter"
                android:contentDescription="@null"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/sdm_swipe_cross_vertical_full"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/sdm_interaction_arrow_vert"
                android:scaleType="fitCenter"
                android:contentDescription="@null"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/sdm_swipe_finger_cross"
                android:clickable="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginLeft="23dp"
                android:layout_marginTop="30dp"
                android:src="@drawable/sdm_interaction_gesture"
                android:scaleType="fitCenter"
                android:contentDescription="@null"/>
        </FrameLayout>
    </FrameLayout>
    <TextView
        android:textSize="12sp"
        android:textColor="#bfbfbf"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/sdm_swipe_hint_text"
        android:background="@drawable/sdm_interaction_swipe_tv_bg"
        android:paddingLeft="30dp"
        android:paddingTop="10dp"
        android:paddingRight="30dp"
        android:paddingBottom="10dp"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="30dp"
        android:layout_marginRight="30dp"
        android:text="@string/sdm_g2c_swipe_hint_text"/>
</LinearLayout>

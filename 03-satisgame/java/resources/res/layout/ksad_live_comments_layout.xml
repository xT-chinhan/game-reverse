<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.kwad.components.core.innerEc.live.widget.OverScrollLayout
        android:id="@+id/ksad_live_comments_container"
        android:layout_width="match_parent"
        android:layout_height="204dp">
        <com.kwad.components.core.innerEc.live.widget.LiveCommentsView
            android:id="@+id/ksad_live_comments_recyclerview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/live_comment_bottom_container"
            android:layout_alignParentTop="true"
            android:layout_alignWithParentIfMissing="true"/>
        <FrameLayout
            android:id="@+id/ksad_live_history_comment_tip_container_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="74dp">
            <com.kwad.components.core.innerEc.live.widget.LiveGradientBackgroundView
                android:id="@+id/ksad_live_history_comment_tip_background_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@android:color/white"
                android:id="@+id/ksad_live_history_comment_tip_text_view"
                android:paddingLeft="8dp"
                android:paddingTop="6dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="没有更多评论了~"/>
        </FrameLayout>
    </com.kwad.components.core.innerEc.live.widget.OverScrollLayout>
</FrameLayout>

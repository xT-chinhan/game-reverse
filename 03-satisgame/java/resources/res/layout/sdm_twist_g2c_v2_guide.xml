<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sdm_twist_bottom_guide_container"
    android:background="#66000000"
    android:clickable="false"
    android:layout_width="match_parent"
    android:layout_height="179dp">
    <LinearLayout
        android:gravity="bottom|center_horizontal"
        android:orientation="vertical"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingBottom="8dp"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/sdm_twist_phone_icon"
            android:clickable="false"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/sdm_interaction_twist_icon"
            android:scaleType="fitCenter"
            android:contentDescription="@null"/>
        <TextView
            android:textSize="20sp"
            android:textColor="#bebebe"
            android:gravity="center"
            android:id="@+id/sdm_twist_main_title"
            android:clickable="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/sdm_g2c_twist_main_title"
            android:textAlignment="gravity"/>
        <TextView
            android:textSize="16sp"
            android:textColor="#bebebe"
            android:gravity="center"
            android:id="@+id/sdm_twist_subtitle"
            android:paddingBottom="6dp"
            android:clickable="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/sdm_g2c_twist_subtitle"
            android:textAlignment="gravity"/>
    </LinearLayout>
</RelativeLayout>

<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/qy_reward_interactive_container"
    android:background="@color/qy_dialog_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/qy_layout_reward_interactive_dialog_common"/>
    <include layout="@layout/qy_layout_push_card"/>
    <ImageView
        android:id="@+id/qy_reward_interactive_close"
        android:visibility="invisible"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginTop="16dp"
        android:src="@drawable/qy_ic_close"
        app:layout_constraintLeft_toRightOf="@+id/qy_reward_interactive_background"
        app:layout_constraintTop_toTopOf="@+id/qy_reward_interactive_desc"/>
</android.support.constraint.ConstraintLayout>

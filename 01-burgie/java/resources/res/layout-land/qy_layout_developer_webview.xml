<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/qy_dialog_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/qy_app_developer_info_webview_outline"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/qy_app_developer_info_webview_guideline"
        app:layout_constraintTop_toTopOf="parent"/>
    <android.support.constraint.Guideline
        android:orientation="vertical"
        android:id="@+id/qy_app_developer_info_webview_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.5"/>
    <View
        android:id="@+id/qy_app_developer_info_webview_card"
        android:background="@drawable/qy_bg_pop_corners"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/qy_app_developer_info_webview_guideline"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="15dp"
        android:textColor="@color/qy_text_color_black_30alpha"
        android:gravity="center"
        android:id="@+id/qy_app_developer_info_webview_close"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="5dp"
        android:text="关闭"
        app:layout_constraintLeft_toLeftOf="@+id/qy_app_developer_info_webview_card"
        app:layout_constraintTop_toTopOf="@+id/qy_app_developer_info_webview_card"/>
    <TextView
        android:textSize="15dp"
        android:textColor="@color/qy_text_color_black_30alpha"
        android:gravity="center"
        android:id="@+id/qy_app_developer_info_webview_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/qy_app_developer_info_webview_close"
        app:layout_constraintLeft_toRightOf="@+id/qy_app_developer_info_webview_close"
        app:layout_constraintRight_toRightOf="@+id/qy_app_developer_info_webview_card"
        app:layout_constraintTop_toTopOf="@+id/qy_app_developer_info_webview_close"/>
    <View
        android:id="@+id/qy_app_developer_info_webview_split"
        android:background="#000"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="8dp"
        android:layout_below="@+id/qy_app_developer_info_webview_close"
        app:layout_constraintLeft_toLeftOf="@+id/qy_app_developer_info_webview_card"
        app:layout_constraintRight_toRightOf="@+id/qy_app_developer_info_webview_card"
        app:layout_constraintTop_toBottomOf="@+id/qy_app_developer_info_webview_title"/>
    <com.mcto.sspsdk.component.webview.QyWebViewCore
        android:id="@+id/qy_layout_developer_webview_core"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/qy_app_developer_info_webview_card"
        app:layout_constraintLeft_toLeftOf="@+id/qy_app_developer_info_webview_card"
        app:layout_constraintRight_toRightOf="@+id/qy_app_developer_info_webview_card"
        app:layout_constraintTop_toBottomOf="@+id/qy_app_developer_info_webview_split"/>
</android.support.constraint.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <ImageView
        android:id="@+id/qy_reward_interactive_background"
        android:layout_width="304dp"
        android:layout_height="422dp"
        android:src="@drawable/qy_bg_reward_interactive"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="17dp"
        android:textColor="@color/qy_text_color_white_90alpha"
        android:id="@+id/qy_reward_interactive_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="47dp"
        android:layout_marginTop="66dp"
        android:text="加速包"
        android:maxEms="8"
        android:singleLine="true"
        app:layout_constraintLeft_toLeftOf="@+id/qy_reward_interactive_background"
        app:layout_constraintTop_toTopOf="@+id/qy_reward_interactive_background"/>
    <TextView
        android:textSize="20dp"
        android:textColor="@color/qy_text_color_black_90alpha"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/qy_reward_interactive_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="26dp"
        android:layout_marginTop="47dp"
        android:layout_marginRight="32dp"
        android:text=""
        android:singleLine="true"
        app:layout_constraintLeft_toLeftOf="@+id/qy_reward_interactive_background"
        app:layout_constraintRight_toRightOf="@+id/qy_reward_interactive_background"
        app:layout_constraintTop_toBottomOf="@+id/qy_reward_interactive_desc"/>
    <View
        android:id="@+id/qy_reward_interactive_ad_info"
        android:background="@drawable/qy_bg_corners15_stroke1_white40_solid_no"
        android:layout_width="0dp"
        android:layout_height="85dp"
        android:layout_marginTop="14dp"
        app:layout_constraintLeft_toLeftOf="@+id/qy_reward_interactive_title"
        app:layout_constraintRight_toRightOf="@+id/qy_reward_interactive_title"
        app:layout_constraintTop_toBottomOf="@+id/qy_reward_interactive_title"/>
    <com.mcto.sspsdk.component.imageview.QYNiceImageView
        android:id="@+id/qy_reward_interactive_app_icon"
        android:layout_width="57dp"
        android:layout_height="57dp"
        android:layout_marginLeft="11dp"
        android:src="@drawable/qy_lg_gift_box_big"
        app:layout_constraintBottom_toBottomOf="@+id/qy_reward_interactive_ad_info"
        app:layout_constraintLeft_toLeftOf="@+id/qy_reward_interactive_title"
        app:layout_constraintTop_toTopOf="@+id/qy_reward_interactive_ad_info"/>
    <TextView
        android:textSize="14dp"
        android:textColor="#000"
        android:gravity="bottom"
        android:id="@+id/qy_reward_interactive_app_name"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="7dp"
        android:layout_marginRight="7dp"
        android:layout_marginBottom="4dp"
        android:text=""
        android:singleLine="true"
        app:layout_constraintBottom_toTopOf="@+id/qy_reward_interactive_ad_title"
        app:layout_constraintLeft_toRightOf="@+id/qy_reward_interactive_app_icon"
        app:layout_constraintRight_toRightOf="@+id/qy_reward_interactive_ad_info"
        app:layout_constraintTop_toTopOf="@+id/qy_reward_interactive_ad_info"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/qy_text_color_black_50alpha"
        android:ellipsize="end"
        android:id="@+id/qy_reward_interactive_ad_title"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="2dp"
        android:text=""
        android:maxLines="2"
        app:layout_constraintBottom_toBottomOf="@+id/qy_reward_interactive_ad_info"
        app:layout_constraintLeft_toLeftOf="@+id/qy_reward_interactive_app_name"
        app:layout_constraintRight_toRightOf="@+id/qy_reward_interactive_app_name"
        app:layout_constraintTop_toBottomOf="@+id/qy_reward_interactive_app_name"/>
    <TextView
        android:textSize="17dp"
        android:textStyle="bold"
        android:textColor="#fff"
        android:gravity="center"
        android:id="@+id/qy_reward_interactive_button"
        android:background="@drawable/qy_gradient_corners_red_btn"
        android:layout_width="0dp"
        android:layout_height="46dp"
        android:layout_marginTop="14dp"
        android:text="领取加速"
        android:maxEms="8"
        android:singleLine="true"
        app:layout_constraintLeft_toLeftOf="@+id/qy_reward_interactive_title"
        app:layout_constraintRight_toRightOf="@+id/qy_reward_interactive_title"
        app:layout_constraintTop_toBottomOf="@+id/qy_reward_interactive_ad_info"/>
    <ImageView
        android:id="@+id/qy_reward_interactive_ripple"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginRight="37dp"
        android:src="@drawable/qy_ic_ripple"
        android:translationZ="11dp"
        app:layout_constraintBottom_toBottomOf="@+id/qy_reward_interactive_button"
        app:layout_constraintRight_toRightOf="@+id/qy_reward_interactive_button"
        app:layout_constraintTop_toTopOf="@+id/qy_reward_interactive_button"/>
    <ImageView
        android:id="@+id/qy_reward_interactive_hand"
        android:layout_width="50dp"
        android:layout_height="70dp"
        android:layout_marginLeft="11dp"
        android:src="@drawable/qy_lg_hand_click"
        android:translationZ="11dp"
        app:layout_constraintLeft_toLeftOf="@+id/qy_reward_interactive_ripple"
        app:layout_constraintTop_toTopOf="@+id/qy_reward_interactive_ripple"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/qy_text_color_black_50alpha"
        android:gravity="center"
        android:id="@+id/qy_reward_interactive_countdown"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text=""
        android:singleLine="true"
        app:layout_constraintLeft_toLeftOf="@+id/qy_reward_interactive_title"
        app:layout_constraintRight_toRightOf="@+id/qy_reward_interactive_title"
        app:layout_constraintTop_toBottomOf="@+id/qy_reward_interactive_button"/>
</merge>

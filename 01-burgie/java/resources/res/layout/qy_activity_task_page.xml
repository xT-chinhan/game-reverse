<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.mcto.sspsdk.component.imageview.QYNiceImageView
        android:id="@+id/qy_task_page_header_image"
        android:background="@color/qy_level1_CLR"
        android:layout_width="match_parent"
        android:layout_height="210dp"
        android:scaleType="centerCrop"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/qy_task_page_header_title_mask_layer"
        android:background="@drawable/qy_gradient_black_100_to_0_bg"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        app:layout_constraintBottom_toBottomOf="@+id/qy_task_page_header_image"/>
    <TextView
        android:textSize="15dp"
        android:textColor="#fff"
        android:gravity="center_vertical"
        android:id="@+id/qy_task_page_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="3.5dp"
        android:text="直通大结局"
        android:singleLine="true"
        app:layout_constraintBottom_toBottomOf="@+id/qy_task_page_header_image"
        app:layout_constraintLeft_toLeftOf="@+id/qy_task_page_progress_card_bg"
        app:layout_constraintRight_toRightOf="@+id/qy_task_page_progress_card_bg"/>
    <TextView
        android:textSize="21dp"
        android:textColor="@color/qy_text_color_white_95alpha"
        android:gravity="center_vertical"
        android:id="@+id/qy_task_page_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="做任务，免费看"
        android:singleLine="true"
        app:layout_constraintBottom_toTopOf="@+id/qy_task_page_subtitle"
        app:layout_constraintLeft_toLeftOf="@+id/qy_task_page_progress_card_bg"
        app:layout_constraintRight_toRightOf="@+id/qy_task_page_progress_card_bg"/>
    <View
        android:id="@+id/qy_task_page_progress_card_bg"
        android:background="@drawable/qy_bg_corners10_gradient_gold"
        android:layout_width="match_parent"
        android:layout_height="85dp"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="3dp"
        android:layout_marginRight="10dp"
        android:alpha="10"
        app:layout_constraintTop_toBottomOf="@+id/qy_task_page_header_image"/>
    <TextView
        android:textSize="15dp"
        android:textColor="@color/qy_vip_text_color"
        android:id="@+id/qy_task_page_progress_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="7dp"
        android:text="当前进度 0%"
        app:layout_constraintLeft_toLeftOf="@+id/qy_task_page_progress_card_bg"
        app:layout_constraintTop_toTopOf="@+id/qy_task_page_progress_card_bg"/>
    <RelativeLayout
        android:id="@+id/qy_task_page_progress_poster_group"
        android:visibility="visible"
        android:layout_width="48dp"
        android:layout_height="75dp"
        android:layout_marginRight="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/qy_task_page_progress_card_bg"
        app:layout_constraintRight_toRightOf="@+id/qy_task_page_progress_card_bg"
        app:layout_constraintTop_toTopOf="@+id/qy_task_page_progress_card_bg">
        <com.mcto.sspsdk.component.imageview.QYNiceImageView
            android:id="@+id/qy_task_page_progress_poster_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@color/qy_text_color_black_40alpha"
            android:scaleType="fitXY"/>
        <TextView
            android:textSize="33dp"
            android:textColor="@color/qy_vip_button_bg2"
            android:gravity="center"
            android:id="@+id/qy_task_page_progress_poster_value"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:letterSpacing="-0.12"/>
        <ImageView
            android:textSize="5dp"
            android:gravity="center"
            android:id="@+id/qy_task_page_poster_label"
            android:layout_width="37dp"
            android:layout_height="14dp"
            android:src="@drawable/qy_lg_jiagengli"
            android:layout_alignParentTop="true"
            android:layout_alignParentRight="true"/>
    </RelativeLayout>
    <com.mcto.sspsdk.ssp.taskpage.QyEnergyProgressBar
        android:id="@+id/qy_task_page_progress_bar"
        android:layout_width="0dp"
        android:layout_height="55dp"
        app:layout_constraintBottom_toBottomOf="@+id/qy_task_page_progress_poster_group"
        app:layout_constraintLeft_toLeftOf="@+id/qy_task_page_progress_desc"
        app:layout_constraintRight_toLeftOf="@+id/qy_task_page_progress_poster_group"
        app:layout_constraintTop_toTopOf="@+id/qy_task_page_progress_poster_group"/>
    <RelativeLayout
        android:id="@+id/qy_task_page_time_mission_group"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        app:layout_constraintLeft_toLeftOf="@+id/qy_task_page_progress_card_bg"
        app:layout_constraintRight_toRightOf="@+id/qy_task_page_progress_card_bg"
        app:layout_constraintTop_toBottomOf="@+id/qy_task_page_progress_card_bg">
        <TextView
            android:textSize="15dp"
            android:textColor="#fff"
            android:id="@+id/qy_task_page_time_mission_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="限时惊喜福利"/>
        <TextView
            android:textSize="11dp"
            android:textColor="#ffd98c"
            android:id="@+id/qy_task_page_time_mission_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:text=""
            android:layout_toRightOf="@+id/qy_task_page_time_mission_title"
            android:layout_alignBaseline="@+id/qy_task_page_time_mission_title"/>
        <com.mcto.sspsdk.ssp.taskpage.TaskAdItemView
            android:id="@+id/qy_task_page_time_mission_card"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="9dp"
            android:layout_below="@+id/qy_task_page_time_mission_title"/>
    </RelativeLayout>
    <com.mcto.sspsdk.ssp.utils.ClickAnimationView
        android:id="@+id/qy_task_page_time_guide_animation"
        android:visibility="gone"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:translationX="-5dp"
        android:translationY="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/qy_task_page_time_mission_group"
        app:layout_constraintRight_toRightOf="@+id/qy_task_page_time_mission_group"/>
    <TextView
        android:textSize="15dp"
        android:textColor="#fff"
        android:id="@+id/qy_task_page_base_task_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:text="基础任务"
        app:layout_constraintLeft_toLeftOf="@+id/qy_task_page_progress_card_bg"
        app:layout_constraintTop_toBottomOf="@+id/qy_task_page_time_mission_group"
        app:layout_goneMarginTop="25dp"/>
    <TextView
        android:textSize="13dp"
        android:textColor="@color/qy_text_color_white_70alpha"
        android:id="@+id/qy_task_page_refresh_base_task"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:text="换一换"
        android:drawableLeft="@drawable/qy_ic_loading_double_arrow_no_bg"
        android:drawablePadding="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/qy_task_page_base_task_title"
        app:layout_constraintRight_toRightOf="@+id/qy_task_page_progress_card_bg"
        app:layout_constraintTop_toTopOf="@+id/qy_task_page_base_task_title"/>
    <android.support.v7.widget.RecyclerView
        android:id="@+id/qy_task_page_base_task_list"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="9dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="@+id/qy_task_page_progress_card_bg"
        app:layout_constraintRight_toRightOf="@+id/qy_task_page_progress_card_bg"
        app:layout_constraintTop_toBottomOf="@+id/qy_task_page_base_task_title"/>
    <ProgressBar
        android:id="@+id/qy_task_page_base_ad_loading_icon"
        android:background="@drawable/qy_lg_cycle"
        android:padding="5dp"
        android:visibility="gone"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginTop="30dp"
        android:indeterminateTint="@color/qy_button_color_green_new"
        app:layout_constraintLeft_toLeftOf="@+id/qy_task_page_base_task_list"
        app:layout_constraintRight_toRightOf="@+id/qy_task_page_base_task_list"
        app:layout_constraintTop_toBottomOf="@+id/qy_task_page_base_task_title"/>
    <TextView
        android:textSize="15dp"
        android:textColor="@color/qy_text_color_white_95alpha"
        android:gravity="center"
        android:id="@+id/qy_task_page_no_ad_tips"
        android:paddingLeft="15dp"
        android:paddingRight="15dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:layout_marginTop="125dp"
        android:text="未找到合适的任务，休息一会儿再试吧"
        app:layout_constraintLeft_toLeftOf="@+id/qy_task_page_progress_card_bg"
        app:layout_constraintRight_toRightOf="@+id/qy_task_page_progress_card_bg"
        app:layout_constraintTop_toBottomOf="@+id/qy_task_page_base_task_title"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/qy_task_page_loading_group"
        android:background="#191c21"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ProgressBar
            android:id="@+id/qy_task_page_loading_icon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:indeterminateTint="@color/qy_button_color_green_new"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textColor="@color/qy_text_color_white_95alpha"
            android:gravity="center"
            android:id="@+id/qy_task_page_loading_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="7dp"
            android:text="努力加载中..."/>
        <TextView
            android:textSize="15dp"
            android:textColor="#000"
            android:gravity="center"
            android:id="@+id/qy_task_page_loading_retry"
            android:background="@drawable/qy_bg_stroke_exit_dialog_icon_bg"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="20dp"
            android:text="点击重试"
            android:fontFamily="sans-serif-black"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/qy_task_page_action_bar"
        android:background="@drawable/qy_gradient_black_0_to_100_bg"
        android:paddingLeft="20dp"
        android:paddingTop="30dp"
        android:paddingRight="20dp"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@+id/qy_task_page_header_image">
        <ImageView
            android:id="@+id/qy_task_page_black_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/qy_ic_arrow_left_bold_with_bg"/>
        <TextView
            android:textSize="13dp"
            android:textColor="@color/qy_text_color_white_80alpha"
            android:gravity="center"
            android:id="@+id/qy_task_page_rules_link"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="规则"
            android:layout_weight="1"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:src="@drawable/qy_ic_arrow_left_bold_with_bg"
            android:rotation="180"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/qy_task_page_glow_circle"
        android:visibility="gone"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/qy_glow_circle"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</android.support.constraint.ConstraintLayout>

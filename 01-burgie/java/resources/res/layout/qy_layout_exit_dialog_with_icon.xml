<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:layout_width="280dp"
    android:layout_height="wrap_content"
    app:layout_constraintHeight_min="334dp">
    <View
        android:id="@+id/dialog_background_text"
        android:background="@drawable/qy_bg_corner15_solid_white"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="@+id/qy_dialog_img"/>
    <ImageView
        android:id="@+id/qy_dialog_img"
        android:layout_width="100dp"
        android:layout_height="74dp"
        android:src="@drawable/qy_lg_gift_box_big"
        app:layout_constraintBottom_toTopOf="@+id/qy_dialog_msg"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textSize="18dp"
        android:textStyle="bold"
        android:textColor="#161823"
        android:gravity="center"
        android:id="@+id/qy_dialog_msg"
        android:layout_width="234dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:text="继续观看视频可获得奖励"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintBottom_toTopOf="@+id/qy_dialog_icon"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/qy_dialog_img"/>
    <com.mcto.sspsdk.component.imageview.QYNiceImageView
        android:id="@+id/qy_dialog_icon"
        android:background="@drawable/qy_bg_stroke_exit_dialog_icon_bg"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginLeft="28dp"
        android:layout_marginTop="20dp"
        app:layout_constraintBottom_toTopOf="@+id/qy_dialog_conversion_btn"
        app:layout_constraintEnd_toStartOf="@+id/qy_dialog_detail"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/qy_dialog_msg"/>
    <TextView
        android:textSize="16dp"
        android:textStyle="bold"
        android:textColor="#161823"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/qy_dialog_detail"
        android:layout_width="wrap_content"
        android:layout_height="25dp"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="28dp"
        android:maxWidth="160dp"
        android:singleLine="true"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintBottom_toBottomOf="@+id/qy_dialog_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/qy_dialog_icon"
        app:layout_constraintTop_toBottomOf="@+id/qy_dialog_msg"
        app:layout_constraintTop_toTopOf="@+id/qy_dialog_icon"/>
    <TextView
        android:textSize="16dp"
        android:textColor="#fe2c55"
        android:gravity="center"
        android:id="@+id/qy_dialog_conversion_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="10dp"
        android:text="了解详情"
        android:maxLines="1"
        android:maxLength="10"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintBottom_toTopOf="@+id/qy_dialog_positive_btn"
        app:layout_constraintEnd_toStartOf="@+id/qy_dialog_conversion_img"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/qy_dialog_icon"/>
    <ImageView
        android:id="@+id/qy_dialog_conversion_img"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:src="@drawable/qy_ic_arrow_right_red"
        android:scaleType="fitCenter"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/qy_dialog_conversion_btn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/qy_dialog_conversion_btn"
        app:layout_constraintTop_toTopOf="@+id/qy_dialog_conversion_btn"/>
    <TextView
        android:textSize="18dp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/qy_dialog_positive_btn"
        android:background="@drawable/qy_gradient_corners_red_btn"
        android:layout_width="234dp"
        android:layout_height="49dp"
        android:layout_marginTop="30dp"
        android:text="@string/qy_reward_exit_dialog_positive_title"
        app:layout_constraintBottom_toTopOf="@+id/qy_dialog_negative_btn"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/qy_dialog_conversion_btn"/>
    <TextView
        android:textSize="14dp"
        android:textColor="#333733"
        android:gravity="center"
        android:id="@+id/qy_dialog_negative_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:layout_marginBottom="10dp"
        android:text="@string/qy_reward_exit_dialog_negative_title"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/qy_dialog_positive_btn"/>
</android.support.constraint.ConstraintLayout>

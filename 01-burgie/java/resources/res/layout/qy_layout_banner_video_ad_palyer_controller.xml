<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.mcto.sspsdk.component.imageview.QYNiceImageView
        android:id="@+id/qy_banner_ad_player_cover_image"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"/>
    <FrameLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/qy_banner_ad_player_completed"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/qy_banner_ad_player_loading"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:indeterminateDrawable="@drawable/qy_ic_loading_1"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/qy_banner_ad_player_error"
        android:background="@android:color/black"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="13sp"
            android:textColor="@android:color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="播放错误，请重试。"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@android:color/white"
            android:id="@+id/qy_banner_ad_player_retry"
            android:background="@drawable/qy_bg_corners20_solid_grey"
            android:paddingLeft="12dp"
            android:paddingTop="4dp"
            android:paddingRight="12dp"
            android:paddingBottom="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="点击重试"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/qy_banner_ad_player_center_start"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true">
        <ImageView
            android:layout_gravity="center"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/qy_ic_start_with_bg"/>
    </FrameLayout>
    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_alignParentBottom="true">
        <View
            android:id="@+id/qy_banner_ad_player_blank"
            android:visibility="visible"
            android:layout_width="27dp"
            android:layout_height="5dp"
            android:layout_marginLeft="10dp"
            android:layout_marginBottom="12dp"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="10dp"/>
        <ImageView
            android:id="@+id/qy_banner_ad_player_volume"
            android:visibility="visible"
            android:layout_width="27dp"
            android:layout_height="27dp"
            android:layout_marginLeft="10dp"
            android:layout_marginBottom="12dp"
            android:src="@drawable/qy_ic_volume_on_with_bg"
            android:layout_above="@+id/qy_banner_ad_player_blank"
            android:layout_marginStart="10dp"/>
    </RelativeLayout>
    <TextView
        android:textSize="14sp"
        android:textColor="#ffffffff"
        android:id="@+id/qy_banner_ad_player_completed_replay"
        android:padding="2dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="19dp"
        android:layout_marginBottom="14dp"
        android:text=" 重播"
        android:drawableLeft="@drawable/qy_ic_loading_one_arrow_with_no_bg"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>

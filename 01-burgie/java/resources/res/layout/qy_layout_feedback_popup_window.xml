<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@drawable/qy_bg_corners7_stroke1_white_solid_white"
    android:layout_width="330dp"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="13dp"
        android:textColor="#1e1e1e"
        android:gravity="center"
        android:id="@+id/qy_feedback_title"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:layout_marginTop="10dp"
        android:text="请选择关闭原因，以减少此类广告推送"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="14dp"
            android:textColor="#1e1e1e"
            android:gravity="center"
            android:id="@+id/qy_feedback_item1"
            android:background="@drawable/qy_bg_corners18_stroke1_green_solid_white"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="15dp"
            android:text="不感兴趣"
            android:height="35dp"
            android:layout_weight="1"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#1e1e1e"
            android:gravity="center"
            android:id="@+id/qy_feedback_item2"
            android:background="@drawable/qy_bg_corners18_stroke1_green_solid_white"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="15dp"
            android:text="违法违规"
            android:height="35dp"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>

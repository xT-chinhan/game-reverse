<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/qy_reward_interactive_container"
    android:background="@color/qy_dialog_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/qy_dialog_background"
        android:background="@drawable/qy_bg_corners35_gradient_gold"
        android:layout_width="283dp"
        android:layout_height="184dp"
        app:layout_constraintBottom_toTopOf="@+id/qy_reward_interactive_close"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <ImageView
        android:id="@+id/qy_dialog_img_1"
        android:layout_width="129dp"
        android:layout_height="104.5dp"
        android:src="@drawable/qy_ic_gold_logo"
        android:translationY="-58.5dp"
        app:layout_constraintLeft_toLeftOf="@+id/qy_dialog_background"
        app:layout_constraintRight_toRightOf="@+id/qy_dialog_background"
        app:layout_constraintTop_toTopOf="@+id/qy_dialog_background"/>
    <com.mcto.sspsdk.component.imageview2.QYImageView2
        android:id="@+id/qy_dialog_img"
        android:layout_width="117dp"
        android:layout_height="117dp"
        android:layout_marginTop="19.4dp"
        android:layout_marginRight="51.2dp"
        app:layout_constraintRight_toRightOf="@+id/qy_dialog_background"
        app:layout_constraintTop_toTopOf="@+id/qy_dialog_background"/>
    <TextView
        android:textSize="41dp"
        android:textStyle="bold"
        android:textColor="#4d2700"
        android:gravity="center"
        android:id="@+id/qy_dialog_msg"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="41.5dp"
        android:includeFontPadding="false"
        app:layout_constraintLeft_toLeftOf="@+id/qy_dialog_background"
        app:layout_constraintRight_toRightOf="@+id/qy_dialog_background"
        app:layout_constraintTop_toTopOf="@+id/qy_dialog_background"/>
    <TextView
        android:textSize="17dp"
        android:textColor="@color/qy_vip_text_color"
        android:gravity="center"
        android:id="@+id/qy_dialog_button_left"
        android:background="@drawable/qy_gradient_corners_vip_text_hollow_btn"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/qy_dialog_background"
        app:layout_constraintLeft_toLeftOf="@+id/qy_dialog_background"
        app:layout_constraintRight_toLeftOf="@+id/qy_dialog_button_right"/>
    <TextView
        android:textSize="17dp"
        android:textStyle="bold"
        android:textColor="#fff"
        android:gravity="center"
        android:id="@+id/qy_dialog_button_right"
        android:background="@drawable/qy_gradient_corners_vip_btn"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/qy_dialog_background"
        app:layout_constraintLeft_toRightOf="@+id/qy_dialog_button_left"
        app:layout_constraintRight_toRightOf="@+id/qy_dialog_background"
        app:layout_constraintWidth_max="145dp"/>
    <ImageView
        android:id="@+id/qy_reward_interactive_close"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginTop="@dimen/qy_dialog_close_margin_top_content"
        android:src="@drawable/qy_ic_close"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="@+id/qy_dialog_background"
        app:layout_constraintRight_toRightOf="@+id/qy_dialog_background"
        app:layout_constraintTop_toBottomOf="@+id/qy_dialog_background"
        app:layout_constraintVertical_chainStyle="packed"/>
</android.support.constraint.ConstraintLayout>

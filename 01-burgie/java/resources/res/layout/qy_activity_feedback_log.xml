<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/qy_layout_feedback"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/qy_feedback_main_layout"
        android:background="@drawable/qy_bg_interstitial_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <EditText
            android:textSize="14dp"
            android:textColor="#000"
            android:id="@+id/qy_feedback_ticket"
            android:background="@drawable/qy_bg_corners18_stroke1_green_solid_white"
            android:paddingLeft="20dp"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="15dp"
            android:layout_marginRight="10dp"
            android:hint="@string/qy_feedback_detail_contact_hint"/>
        <Button
            android:textSize="18dp"
            android:textColor="#fff"
            android:id="@+id/qy_feedback_ticket_btn"
            android:background="@drawable/qy_gradient_green_button_bg"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="15dp"
            android:layout_marginRight="10dp"
            android:text="@string/qy_button_submit"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#000"
            android:id="@+id/qy_feedback_sdk_info"
            android:background="@drawable/qy_bg_corners18_stroke1_green_solid_white"
            android:padding="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="15dp"
            android:layout_marginRight="10dp"
            android:text="11111"
            android:minLines="2"/>
    </LinearLayout>
</FrameLayout>

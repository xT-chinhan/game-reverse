<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/compliance_bg_white_radius_8dp"
    android:layout_width="335dp"
    android:layout_height="320dp">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include
            android:id="@+id/include_title_bar"
            layout="@layout/compliance_dialog_common_title_bar"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_use_tap_real_name_tips"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:layout_gravity="center_horizontal"
                    android:layout_width="120dp"
                    android:layout_height="50dp"
                    android:src="@drawable/logo_tap_certification_service"/>
                <WebView
                    android:id="@+id/web_content"
                    android:layout_width="match_parent"
                    android:layout_height="130dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginHorizontal="20dp"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/tv_alert_button_container"
            android:padding="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="12dp"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:gravity="center"
                android:id="@+id/tv_disagree_use_button"
                android:background="@drawable/compliance_alert_negative_gray_bg"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:text="不使用"
                android:layout_weight="1"
                android:layout_marginHorizontal="6dp"/>
            <TextView
                android:textSize="12dp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:id="@+id/tv_agree_use_button"
                android:background="@drawable/compliance_alert_positive_bg"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:text="使用"
                android:layout_weight="1"
                android:layout_marginHorizontal="6dp"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>

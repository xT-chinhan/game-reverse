<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.mcto.sspsdk.component.interaction.QyTwistView
        android:id="@+id/qy_splash_action_icon"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginBottom="7dp"
        app:layout_constraintBottom_toTopOf="@+id/qy_splash_action_title"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textSize="16dp"
        android:textStyle="bold"
        android:textColor="#fff"
        android:id="@+id/qy_splash_action_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="5dp"
        android:text="扭动手机"
        android:lines="1"
        app:layout_constraintBottom_toTopOf="@+id/qy_splash_action_sub_title"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/qy_splash_action_icon"/>
    <TextView
        android:textSize="12dp"
        android:textColor="#fff"
        android:id="@+id/qy_splash_action_sub_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="19dp"
        android:text="@string/qy_action_desc"
        android:lines="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/qy_splash_action_title"/>
</merge>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="horizontal"
    android:id="@+id/layLeft"
    android:background="@drawable/mar_float_action_button_bg"
    android:layout_width="wrap_content"
    android:layout_height="50dp">
    <ImageView
        android:id="@+id/icon"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:src="@drawable/mar_float_button_logo"
        android:scaleType="centerInside"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/content"
        android:layout_width="wrap_content"
        android:layout_height="50dp">
        <TextView
            android:textSize="12dp"
            android:textColor="@color/mar_ffffff"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/back_item"
            android:paddingLeft="5dp"
            android:paddingRight="10dp"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:maxWidth="140dp"
            android:text="更多信息"
            android:maxLines="2"/>
        <FrameLayout
            android:id="@+id/close_item"
            android:paddingRight="15dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent">
            <ImageView
                android:layout_gravity="center_vertical"
                android:padding="3dp"
                android:visibility="visible"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/mar_privacy_ball_close"/>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>

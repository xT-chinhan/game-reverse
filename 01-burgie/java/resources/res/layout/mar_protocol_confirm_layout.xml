<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#00000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/mar_dialog_corner_bg"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <RelativeLayout style="@style/mar_common_title">
            <TextView
                android:textSize="@dimen/mar_common_textsize_l"
                android:textColor="@android:color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mar_permission_confirm_title"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
        <View
            android:layout_height="10dp"
            style="@style/mar_common_divide"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="8dp"
            android:layout_marginBottom="2dp">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/mar_common_textsize_m"
                    android:textColor="@color/mar_dark"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mar_permission_confirm_txt1"/>
            </LinearLayout>
            <LinearLayout
                android:layout_gravity=""
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/mar_common_textsize_m"
                    android:textStyle="bold"
                    android:textColor="@color/mar_title_blue"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/mar_protocol_addr2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="1dp"
                    android:text="@string/mar_permission_protocol"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/mar_common_textsize_m"
                    android:textColor="@color/mar_dark"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mar_permission_confirm_txt2"/>
            </LinearLayout>
        </LinearLayout>
        <View
            android:layout_height="10dp"
            style="@style/mar_common_divide"/>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_margin="2dp">
            <Button
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/mar_btn_gray"
                android:gravity="center"
                android:id="@+id/mar_protocol_cancel"
                android:background="@drawable/mar_corner_gray"
                android:visibility="visible"
                android:layout_width="0dp"
                android:layout_height="35dp"
                android:layout_marginLeft="6dp"
                android:layout_marginTop="1dp"
                android:layout_marginBottom="1dp"
                android:text="@string/mar_permission_confirm_cancel"
                android:layout_weight="1"/>
            <Button
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:id="@+id/mar_protocol_ok"
                android:background="@drawable/mar_corner_button"
                android:visibility="visible"
                android:layout_width="0dp"
                android:layout_height="35dp"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="1dp"
                android:layout_marginRight="6dp"
                android:layout_marginBottom="1dp"
                android:text="@string/mar_permission_confirm_ok"
                android:layout_weight="1"/>
        </LinearLayout>
        <View
            android:layout_height="10dp"
            style="@style/mar_common_divide"/>
    </LinearLayout>
</RelativeLayout>

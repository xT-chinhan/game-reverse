<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/update_error_dialog_root_container"
    android:background="@drawable/tapupdate_bg_dialog_update"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_ready_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="60dp"
            android:layout_marginHorizontal="22dp"
            android:layout_marginVertical="20dp">
            <ImageView
                android:id="@+id/iv_request_error"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/tapupdate_icon_error"/>
            <TextView
                android:textColor="#222222"
                android:id="@+id/tv_ready_tips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="请求失败，请重试"
                android:layout_marginStart="8dp"
                style="@style/tap_china_heading_16_b"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:paddingTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:paddingHorizontal="14dp">
            <TextView
                android:textColor="#222222"
                android:gravity="center"
                android:id="@+id/update_error_dialog_cancel"
                android:background="@drawable/tapupdate_selector_func_button_negative"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:text="取消"
                android:layout_weight="1"
                style="@style/tap_china_heading_14_b"/>
            <TextView
                android:textColor="@android:color/white"
                android:gravity="center"
                android:id="@+id/update_error_dialog_retry"
                android:background="@drawable/tapupdate_selector_func_button_positive"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:text="点击重试"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                style="@style/tap_china_heading_14_b"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

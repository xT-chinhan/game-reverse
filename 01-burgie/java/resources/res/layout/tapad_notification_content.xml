<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/tapad_notification_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:scaleType="centerCrop"
        android:contentDescription="@null"
        android:layout_marginEnd="8dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:ellipsize="end"
                android:id="@+id/tapad_notification_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_weight="1"
                style="@android:style/TextAppearance.Material.Notification.Title"/>
            <TextView
                android:id="@+id/tapad_notification_progress_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_marginStart="8dp"
                style="@android:style/TextAppearance.Material.Notification.Title"/>
        </LinearLayout>
        <ProgressBar
            android:id="@+id/tapad_notification_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            style="@android:style/Widget.Material.ProgressBar.Horizontal"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:ellipsize="end"
                android:id="@+id/tapad_notification_content"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_weight="1"
                style="@android:style/TextAppearance.Material.Notification.Info"/>
            <TextView
                android:id="@+id/tapad_notification_sub_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_marginStart="8dp"
                style="@android:style/TextAppearance.Material.Notification.Info"/>
        </LinearLayout>
    </LinearLayout>
    <Button
        android:textSize="11sp"
        android:textColor="#1042a6"
        android:id="@+id/tapad_notification_cancel"
        android:background="@drawable/tapad_notification_button"
        android:layout_width="55dp"
        android:layout_height="35dp"
        android:text="@string/tapad_btn_cancel"
        android:layout_marginStart="8dp"/>
    <Button
        android:textSize="11sp"
        android:textColor="#1042a6"
        android:id="@+id/tapad_notification_action"
        android:background="@drawable/tapad_notification_button"
        android:visibility="gone"
        android:layout_width="55dp"
        android:layout_height="35dp"
        android:layout_marginStart="8dp"/>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/qy_splash_action_icon"
        android:layout_width="100dp"
        android:layout_height="120dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="16dp"
        android:textStyle="bold"
        android:textColor="#fff"
        android:id="@+id/qy_splash_action_title"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:layout_marginBottom="5dp"
        android:text="随意滑动手机"
        android:lines="1"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/qy_splash_action_icon"/>
    <TextView
        android:textSize="12dp"
        android:textColor="#fff"
        android:gravity="center"
        android:id="@+id/qy_splash_action_sub_title"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:layout_marginBottom="19dp"
        android:text="@string/qy_action_desc"
        android:lines="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/qy_splash_action_title"/>
</merge>

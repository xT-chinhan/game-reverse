<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/force_update_root"
    android:background="@drawable/tapupdate_bg_dialog_update"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="8dp"
    android:paddingHorizontal="16dp"
    android:paddingVertical="14dp">
    <TextView
        android:textColor="#222222"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="游戏有新版本"
        style="@style/tap_china_heading_14_b"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp">
        <TextView
            android:textColor="#8e8e8e"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="版本"
            style="@style/tap_china_caption_10_r"/>
        <TextView
            android:textColor="#222222"
            android:ellipsize="end"
            android:id="@+id/force_update_game_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="6dp"
            style="@style/tap_china_caption_10_r"/>
        <TextView
            android:textColor="#8e8e8e"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="发布日期"
            android:layout_marginStart="20dp"
            style="@style/tap_china_caption_10_r"/>
        <TextView
            android:textColor="#222222"
            android:ellipsize="end"
            android:id="@+id/force_update_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="6dp"
            style="@style/tap_china_caption_10_r"/>
    </LinearLayout>
    <TextView
        android:textColor="#8e8e8e"
        android:id="@+id/force_update_content_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="更新日志"
        style="@style/tap_china_caption_12_r"/>
    <TextView
        android:scrollbarStyle="outsideInset"
        android:textColor="#8e8e8e"
        android:id="@+id/force_update_content"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:maxHeight="200dp"
        android:layout_weight="1"
        style="@style/tap_china_caption_12_r"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">
        <TextView
            android:textColor="#222222"
            android:gravity="center"
            android:id="@+id/force_update_exit"
            android:background="@drawable/tapupdate_selector_func_button_negative"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:text="退出游戏"
            android:layout_weight="1"
            style="@style/tap_china_heading_14_b"/>
        <TextView
            android:textColor="@color/tap_sdk_common_primary_white"
            android:gravity="center"
            android:id="@+id/force_update_confirm"
            android:background="@drawable/tapupdate_selector_func_button_positive"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:text="去更新"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            style="@style/tap_china_heading_14_b"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/tips_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:src="@drawable/tap_update_tips"/>
        <TextView
            android:textColor="#cacaca"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="本游戏需使用 TapTap 客户端更新"
            android:layout_marginStart="2dp"
            style="@style/tap_china_caption_10_r"/>
    </LinearLayout>
</LinearLayout>

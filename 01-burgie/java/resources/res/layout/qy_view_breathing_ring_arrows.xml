<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <android.support.constraint.Guideline
        android:orientation="horizontal"
        android:id="@+id/qy_arrow_top_guide"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintGuide_percent="0.065"/>
    <android.support.constraint.Guideline
        android:orientation="horizontal"
        android:id="@+id/qy_arrow_bottom_guide"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintGuide_percent="0.935"/>
    <android.support.constraint.Guideline
        android:orientation="vertical"
        android:id="@+id/qy_arrow_left_guide"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintGuide_percent="0.065"/>
    <android.support.constraint.Guideline
        android:orientation="vertical"
        android:id="@+id/qy_arrow_right_guide"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintGuide_percent="0.935"/>
    <com.mcto.sspsdk.component.interaction.QyRingView
        android:id="@+id/qy_ring_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageView
        android:id="@+id/qy_arrow_top"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/qy_animated_double_arrow"
        android:scaleType="fitCenter"
        android:rotation="90"
        app:layout_constraintEnd_toEndOf="@+id/qy_ring_view"
        app:layout_constraintHeight_percent="0.28"
        app:layout_constraintStart_toStartOf="@+id/qy_ring_view"
        app:layout_constraintTop_toBottomOf="@+id/qy_arrow_top_guide"
        app:layout_constraintWidth_percent="1"/>
    <ImageView
        android:id="@+id/qy_arrow_bottom"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/qy_animated_double_arrow"
        android:scaleType="fitCenter"
        android:rotation="270"
        app:layout_constraintBottom_toTopOf="@+id/qy_arrow_bottom_guide"
        app:layout_constraintEnd_toEndOf="@+id/qy_ring_view"
        app:layout_constraintHeight_percent="0.28"
        app:layout_constraintStart_toStartOf="@+id/qy_ring_view"
        app:layout_constraintWidth_percent="1"/>
    <ImageView
        android:id="@+id/qy_arrow_left"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/qy_animated_double_arrow"
        android:scaleType="fitCenter"
        android:rotation="0"
        app:layout_constraintBottom_toBottomOf="@+id/qy_ring_view"
        app:layout_constraintHeight_percent="1"
        app:layout_constraintStart_toEndOf="@+id/qy_arrow_left_guide"
        app:layout_constraintTop_toTopOf="@+id/qy_ring_view"
        app:layout_constraintWidth_percent="0.28"/>
    <ImageView
        android:id="@+id/qy_arrow_right"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/qy_animated_double_arrow"
        android:scaleType="fitCenter"
        android:rotation="180"
        app:layout_constraintBottom_toBottomOf="@+id/qy_ring_view"
        app:layout_constraintEnd_toStartOf="@+id/qy_arrow_right_guide"
        app:layout_constraintHeight_percent="1"
        app:layout_constraintTop_toTopOf="@+id/qy_ring_view"
        app:layout_constraintWidth_percent="0.28"/>
</merge>

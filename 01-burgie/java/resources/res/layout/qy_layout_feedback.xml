<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="20dp">
        <TextView
            android:textSize="20dp"
            android:textColor="@color/qy_text_color_black_80alpha"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="信息反馈"/>
        <EditText
            android:textSize="14dp"
            android:textColor="#000"
            android:id="@+id/qy_feedback_contact"
            android:background="@drawable/qy_bg_corners18_stroke1_green_solid_white"
            android:paddingLeft="20dp"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="15dp"
            android:layout_marginRight="10dp"
            android:hint="@string/qy_feedback_detail_contact_hint"/>
        <EditText
            android:textSize="14dp"
            android:textColor="#000"
            android:gravity="top"
            android:id="@+id/qy_feedback_detail_advice"
            android:background="@drawable/qy_bg_corners18_stroke1_green_solid_white"
            android:padding="18dp"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="15dp"
            android:layout_marginRight="10dp"
            android:hint="@string/qy_feedback_detail_message_hint"
            android:maxLines="7"
            android:maxLength="100"
            android:lineSpacingExtra="3dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/qy_switchExample_group"
            android:background="@drawable/qy_bg_corners18_stroke1_green_solid_white"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="10dp">
            <Switch
                android:id="@+id/qy_switchExample"
                android:paddingLeft="20dp"
                android:paddingRight="10dp"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:checked="false"
                android:text="CACHE LOG"
                android:switchMinWidth="60dp"
                style="@style/TextAppearance.AppCompat.Widget.Switch"/>
            <View
                android:background="@color/qy_button_color_green"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginLeft="25dp"
                android:layout_marginRight="25dp"/>
            <Switch
                android:id="@+id/qy_switchExample2"
                android:paddingLeft="20dp"
                android:paddingRight="10dp"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:checked="false"
                android:text="FILE LOG"
                android:switchMinWidth="60dp"
                style="@style/TextAppearance.AppCompat.Widget.Switch"/>
        </LinearLayout>
        <Button
            android:textSize="18dp"
            android:textColor="#fff"
            android:id="@+id/qy_feedback_btn"
            android:background="@drawable/qy_gradient_green_button_bg"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="15dp"
            android:layout_marginRight="10dp"
            android:text="@string/qy_button_submit"/>
    </LinearLayout>
</merge>

<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/qy_text_color_black_70alpha"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <android.support.constraint.ConstraintLayout
        android:background="@drawable/qy_bg_pop_corners"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">
        <com.mcto.sspsdk.component.imageview.QYNiceImageView
            android:id="@+id/qy_download_confirm_app_icon"
            android:layout_width="93dp"
            android:layout_height="93dp"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="20dp"
            android:scaleType="fitCenter"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="22dp"
            android:textStyle="bold"
            android:textColor="#000"
            android:id="@+id/qy_download_confirm_app_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:singleLine="true"
            app:layout_constraintLeft_toRightOf="@+id/qy_download_confirm_app_icon"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/qy_download_confirm_app_icon"/>
        <TextView
            android:textSize="18dp"
            android:textColor="#fff"
            android:id="@+id/qy_download_confirm_app_label"
            android:background="@drawable/qy_gradient_yellow_to_red_icon_bg"
            android:paddingLeft="10dp"
            android:paddingTop="2dp"
            android:paddingRight="10dp"
            android:paddingBottom="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="超火爆下载中"
            app:layout_constraintBottom_toBottomOf="@+id/qy_download_confirm_app_icon"
            app:layout_constraintLeft_toLeftOf="@+id/qy_download_confirm_app_name"
            app:layout_constraintTop_toBottomOf="@+id/qy_download_confirm_app_name"/>
        <TextView
            android:textSize="20dp"
            android:textStyle="bold"
            android:textColor="#000"
            android:id="@+id/qy_download_confirm_app_score_star"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/qy_download_confirm_app_score_star_icon"
            app:layout_constraintTop_toBottomOf="@+id/qy_download_confirm_app_icon"/>
        <ImageView
            android:id="@+id/qy_download_confirm_app_score_star_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginLeft="5dp"
            android:src="@drawable/qy_ic_baseline_star_24"
            app:layout_constraintBottom_toBottomOf="@+id/qy_download_confirm_app_score_star"
            app:layout_constraintLeft_toRightOf="@+id/qy_download_confirm_app_score_star"
            app:layout_constraintRight_toRightOf="@+id/qy_download_confirm_app_score_split"
            app:layout_constraintTop_toTopOf="@+id/qy_download_confirm_app_score_star"/>
        <TextView
            android:textSize="15dp"
            android:textColor="#000"
            android:gravity="center"
            android:id="@+id/qy_download_confirm_app_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/qy_download_confirm_app_score_split"
            app:layout_constraintTop_toBottomOf="@+id/qy_download_confirm_app_score_star"/>
        <View
            android:id="@+id/qy_download_confirm_app_score_split"
            android:background="#959595"
            android:layout_width="1dp"
            android:layout_height="20dp"
            app:layout_constraintBottom_toBottomOf="@+id/qy_download_confirm_app_score"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/qy_download_confirm_app_score_star"/>
        <TextView
            android:textSize="20dp"
            android:textStyle="bold"
            android:textColor="#000"
            android:id="@+id/qy_download_confirm_app_download_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBaseline_toBaselineOf="@+id/qy_download_confirm_app_score_star"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintLeft_toRightOf="@+id/qy_download_confirm_app_score_split"
            app:layout_constraintRight_toRightOf="parent"/>
        <TextView
            android:textSize="15dp"
            android:textColor="#000"
            android:gravity="center"
            android:id="@+id/qy_download_confirm_app_download_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="下载次数"
            android:includeFontPadding="false"
            app:layout_constraintLeft_toRightOf="@+id/qy_download_confirm_app_score_split"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/qy_download_confirm_app_download_count"/>
        <TextView
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="#000"
            android:id="@+id/qy_download_confirm_introduce_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="15dp"
            android:text="应用简介"
            app:layout_constraintLeft_toLeftOf="@+id/qy_download_confirm_introduce_group"
            app:layout_constraintRight_toRightOf="@+id/qy_download_confirm_introduce_group"
            app:layout_constraintTop_toTopOf="@+id/qy_download_confirm_introduce_group"/>
        <TextView
            android:textSize="10dp"
            android:textColor="#000"
            android:id="@+id/qy_download_confirm_title"
            android:paddingBottom="10dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingMultiplier="1.2"
            app:layout_constraintLeft_toLeftOf="@+id/qy_download_confirm_introduce_text"
            app:layout_constraintRight_toRightOf="@+id/qy_download_confirm_introduce_text"
            app:layout_constraintTop_toBottomOf="@+id/qy_download_confirm_introduce_text"/>
        <ImageView
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_marginRight="15dp"
            android:src="@drawable/qy_ic_player_click_back_selector"
            android:layout_alignTop="@+id/qy_download_confirm_introduce_text"
            android:rotation="270"
            app:layout_constraintBottom_toBottomOf="@+id/qy_download_confirm_introduce_text"
            app:layout_constraintDimensionRatio="H,1:1"
            app:layout_constraintRight_toRightOf="@+id/qy_download_confirm_introduce_group"
            app:layout_constraintTop_toTopOf="@+id/qy_download_confirm_introduce_text"/>
        <View
            android:id="@+id/qy_download_confirm_introduce_group"
            android:background="@drawable/qy_bg_corner10_solid_black10"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="20dp"
            android:layout_marginRight="20dp"
            app:layout_constraintBottom_toBottomOf="@+id/qy_download_confirm_title"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/qy_download_confirm_app_download_title"/>
        <com.mcto.sspsdk.component.imageview.QYNiceImageView
            android:id="@+id/qy_download_confirm_cover_image"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="20dp"
            app:layout_constraintDimensionRatio="H,16:9"
            app:layout_constraintLeft_toLeftOf="@+id/qy_download_confirm_introduce_group"
            app:layout_constraintRight_toRightOf="@+id/qy_download_confirm_introduce_group"
            app:layout_constraintTop_toBottomOf="@+id/qy_download_confirm_introduce_group"/>
        <TextView
            android:textSize="18dp"
            android:textColor="#000"
            android:gravity="center"
            android:id="@+id/qy_download_confirm_app_btn_detail_page"
            android:background="@drawable/qy_bg_corner10_solid_grey"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="20dp"
            android:text="了解详情"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/qy_download_confirm_app_btn_download"
            app:layout_constraintTop_toBottomOf="@+id/qy_download_confirm_cover_image"/>
        <com.mcto.sspsdk.component.button.DownloadButtonView
            android:textSize="18dp"
            android:gravity="center"
            android:id="@+id/qy_download_confirm_app_btn_download"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            app:layout_constraintLeft_toRightOf="@+id/qy_download_confirm_app_btn_detail_page"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/qy_download_confirm_app_btn_detail_page"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/qy_download_confirm_app_detail_link"
            android:paddingBottom="20dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/qy_download_confirm_app_btn_detail_page"/>
    </android.support.constraint.ConstraintLayout>
</android.support.constraint.ConstraintLayout>

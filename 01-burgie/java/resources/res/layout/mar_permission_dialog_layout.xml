<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:background="@color/mar_ffffff"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:background="@android:color/background_dark"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.4"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/mar_dialog_corner_brg"
        android:paddingLeft="20dp"
        android:paddingTop="10dp"
        android:paddingRight="20dp"
        android:paddingBottom="10dp"
        android:layout_width="360dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="30dp"
        android:layout_marginRight="30dp"
        android:layout_centerInParent="true">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp">
            <TextView
                android:textSize="@dimen/mar_common_textsize_l"
                android:textColor="@color/mar_btn_gray"
                android:id="@+id/mar_permission_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mar_permission_confirm_title"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="12dp"
                android:textColor="#4eade7"
                android:id="@+id/txt_permission_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mar_permission_desc"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/mar_permission_content"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp">
            <include layout="@layout/mar_permission_gridview"/>
        </RelativeLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/mar_protocol_tip_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="15dp"
                android:textColor="#8e8e8e"
                android:id="@+id/mar_protocol_tip_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="5dp">
            <Button
                android:textSize="14dp"
                android:textStyle="bold"
                android:textColor="#55afe7"
                android:gravity="center"
                android:id="@+id/mar_protocol_cancel"
                android:background="@drawable/mar_dialog_btn_close_bg"
                android:visibility="visible"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_marginRight="8dp"
                android:text="@string/mar_permission_confirm_cancel"
                android:layout_weight="1"/>
            <Button
                android:textSize="14dp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:id="@+id/mar_protocol_ok"
                android:background="@drawable/mar_dialog_btn_agree_bg"
                android:visibility="visible"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_marginLeft="8dp"
                android:text="@string/mar_permission_confirm_ok"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>

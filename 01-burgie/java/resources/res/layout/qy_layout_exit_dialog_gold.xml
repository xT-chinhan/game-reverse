<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/qy_exit_dialog_background"
        android:background="@drawable/qy_bg_corners35_gradient_gold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_min="184dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_min="283dp">
        <TextView
            android:textSize="19dp"
            android:textStyle="bold"
            android:textColor="@color/qy_vip_text_color"
            android:ellipsize="end"
            android:gravity="bottom|center_horizontal"
            android:layout_gravity="center"
            android:id="@+id/qy_dialog_msg"
            android:layout_width="234dp"
            android:layout_height="0dp"
            android:layout_marginBottom="18dp"
            android:text="@string/qy_reward_exit_dialog_title"
            android:maxLines="2"
            android:layout_weight="1"/>
        <TextView
            android:textSize="17dp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/qy_dialog_conversion_btn"
            android:background="@drawable/qy_gradient_corners_vip_btn"
            android:layout_width="251dp"
            android:layout_height="40dp"
            android:text="获取奖励"
            android:singleLine="true"/>
        <TextView
            android:textSize="15dp"
            android:textColor="@color/qy_vip_text_color"
            android:gravity="center_horizontal"
            android:layout_gravity="center"
            android:id="@+id/qy_dialog_negative_btn"
            android:padding="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8.5dp"
            android:layout_marginBottom="8.5dp"
            android:text="@string/qy_reward_exit_dialog_negative_title"
            android:singleLine="true"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/qy_dialog_img"
        android:layout_width="129dp"
        android:layout_height="104.5dp"
        android:src="@drawable/qy_ic_gold_logo"
        android:translationY="-37dp"
        app:layout_constraintLeft_toLeftOf="@+id/qy_exit_dialog_background"
        app:layout_constraintRight_toRightOf="@+id/qy_exit_dialog_background"
        app:layout_constraintTop_toTopOf="@+id/qy_exit_dialog_background"/>
</android.support.constraint.ConstraintLayout>

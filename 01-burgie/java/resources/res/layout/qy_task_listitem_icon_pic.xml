<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/qy_bg_corners10_gradient_gold16"
    android:layout_width="match_parent"
    android:layout_height="66dp">
    <View
        android:id="@+id/qy_card_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.mcto.sspsdk.component.imageview.QYNiceImageView
        android:id="@+id/qy_app_icon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginLeft="10dp"
        android:src="@drawable/qy_lg_gift_box_big_2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="15dp"
        android:textColor="@color/qy_text_color_white_95alpha"
        android:gravity="bottom"
        android:id="@+id/qy_app_name"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="10dp"
        android:text="aiqiyi"
        android:singleLine="true"
        app:layout_constraintBottom_toTopOf="@+id/qy_app_title"
        app:layout_constraintLeft_toRightOf="@+id/qy_app_icon"
        app:layout_constraintRight_toLeftOf="@+id/qy_app_button"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="13dp"
        android:textColor="@color/qy_text_color_white_60alpha"
        android:ellipsize="none"
        android:id="@+id/qy_app_title"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="qy_app_title"
        android:singleLine="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="@+id/qy_app_name"
        app:layout_constraintRight_toRightOf="@+id/qy_app_name"
        app:layout_constraintTop_toBottomOf="@+id/qy_app_name"/>
    <TextView
        android:gravity="center"
        android:id="@+id/qy_app_button"
        android:background="@drawable/qy_gradient_corners_vip_btn"
        android:layout_width="83dp"
        android:layout_height="28dp"
        android:layout_marginRight="10dp"
        android:singleLine="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</android.support.constraint.ConstraintLayout>

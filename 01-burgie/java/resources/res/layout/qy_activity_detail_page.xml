<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/qy_webview_bar"
        android:background="@color/qy_text_color_black_100alpha"
        android:layout_width="match_parent"
        android:layout_height="0dp"/>
    <LinearLayout
        android:id="@+id/qy_webview_top"
        android:background="@color/qy_text_color_black_100alpha"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/qy_detail_page_back"
            android:layout_width="28dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:src="@drawable/qy_ic_arrow_left_no_bg"/>
        <ImageView
            android:id="@+id/qy_detail_page_close"
            android:layout_width="28dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:src="@drawable/qy_ic_close_white"/>
        <ImageView
            android:id="@+id/qy_detail_page_share"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginRight="10dp"
            android:layout_marginBottom="6dp"
            android:src="@drawable/qy_ic_more_2x"
            android:scaleType="fitEnd"
            android:layout_weight="1"/>
    </LinearLayout>
    <com.mcto.sspsdk.component.webview.QyWebViewPanel
        android:id="@+id/qy_webview_panel"
        android:background="@color/qy_text_color_white_90alpha"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
</LinearLayout>

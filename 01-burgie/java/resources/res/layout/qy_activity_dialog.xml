<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/qy_dialog_activity_container"
        android:background="@drawable/qy_gradient_yellow_to_red_icon_bg"
        android:layout_width="300dp"
        android:layout_height="200dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:layout_width="180dp"
        android:layout_height="200dp"
        android:src="@drawable/qy_lg_gift_box_big"
        app:layout_constraintCircle="@+id/qy_dialog_activity_container"
        app:layout_constraintCircleRadius="140dp"/>
    <TextView
        android:textSize="16dp"
        android:textStyle="bold"
        android:textColor="@color/qy_text_color_black_80alpha"
        android:id="@+id/qy_dialog_msg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="40dp"
        android:layout_marginRight="20dp"
        app:layout_constraintBottom_toTopOf="@+id/qy_dialog_positive_btn"
        app:layout_constraintLeft_toLeftOf="@+id/qy_dialog_activity_container"
        app:layout_constraintRight_toRightOf="@+id/qy_dialog_activity_container"
        app:layout_constraintTop_toTopOf="@+id/qy_dialog_activity_container"
        app:layout_constraintVertical_chainStyle="packed"/>
    <Button
        android:textSize="16dp"
        android:textStyle="bold"
        android:textColor="@color/qy_text_color_black_80alpha"
        android:id="@+id/qy_dialog_positive_btn"
        android:background="@drawable/qy_gradient_yellow_to_red_icon_bg"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="15dp"
        android:layout_marginRight="40dp"
        android:text="立即体验"
        app:layout_constraintBottom_toTopOf="@+id/qy_dialog_negative_btn"
        app:layout_constraintLeft_toLeftOf="@+id/qy_dialog_activity_container"
        app:layout_constraintRight_toRightOf="@+id/qy_dialog_activity_container"
        app:layout_constraintTop_toBottomOf="@+id/qy_dialog_msg"/>
    <TextView
        android:textSize="10dp"
        android:textColor="@color/qy_text_color_black_50alpha"
        android:id="@+id/qy_dialog_negative_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:text="稍后尝试"
        app:layout_constraintBottom_toBottomOf="@+id/qy_dialog_activity_container"
        app:layout_constraintLeft_toLeftOf="@+id/qy_dialog_activity_container"
        app:layout_constraintRight_toRightOf="@+id/qy_dialog_activity_container"
        app:layout_constraintTop_toBottomOf="@+id/qy_dialog_positive_btn"/>
</android.support.constraint.ConstraintLayout>

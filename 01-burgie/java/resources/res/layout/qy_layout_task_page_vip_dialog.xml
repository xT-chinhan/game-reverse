<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/qy_dialog_decoration"
        android:visibility="gone"
        android:layout_width="300dp"
        android:layout_height="119dp"
        android:src="@drawable/qy_bg_task_page_dialog_decoration"
        android:scaleType="center"
        android:translationY="60dp"
        app:layout_constraintBottom_toTopOf="@+id/qy_dialog_bg"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/qy_dialog_bg"
        android:background="@drawable/qy_gradient_corners_vip_dialog"
        android:paddingLeft="20dp"
        android:paddingTop="35dp"
        android:paddingRight="20dp"
        android:paddingBottom="20dp"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_max="390dp"
        app:layout_constraintHeight_min="170dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="22dp"
            android:textColor="@color/qy_text_color_black_70alpha"
            android:gravity="center"
            android:id="@+id/qy_dialog_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:maxLines="2"
            android:fontFamily="sans-serif-black"/>
        <FrameLayout
            android:id="@+id/qy_dialog_content"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">
            <TextView
                android:textSize="17dp"
                android:textColor="@color/qy_vip_button_text"
                android:gravity="center"
                android:id="@+id/qy_dialog_negative_btn"
                android:background="@drawable/qy_gradient_corners_vip_hollow_btn"
                android:visibility="gone"
                android:layout_width="90dp"
                android:layout_height="45dp"
                android:layout_marginRight="10dp"
                android:text="关闭"
                android:singleLine="true"/>
            <TextView
                android:textSize="17dp"
                android:textColor="@color/qy_vip_text_color"
                android:gravity="center"
                android:id="@+id/qy_dialog_positive_btn"
                android:background="@drawable/qy_gradient_corners_vip_btn"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:text="继续做任务"
                android:singleLine="true"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
    <com.mcto.sspsdk.component.imageview.QYNiceImageView
        android:id="@+id/qy_dialog_icon"
        android:visibility="gone"
        android:layout_width="75dp"
        android:layout_height="100dp"
        android:scaleType="fitCenter"
        android:translationY="25dp"
        app:layout_constraintBottom_toTopOf="@+id/qy_dialog_bg"
        app:layout_constraintLeft_toLeftOf="@+id/qy_dialog_bg"
        app:layout_constraintRight_toRightOf="@+id/qy_dialog_bg"/>
</android.support.constraint.ConstraintLayout>

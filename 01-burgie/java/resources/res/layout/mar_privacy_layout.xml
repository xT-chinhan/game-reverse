<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/mar_corner_privacy_bg"
        android:layout_width="280dp"
        android:layout_height="315dp">
        <TextView
            android:textSize="18sp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/txtTitle"
            android:paddingLeft="6dp"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="相关信息"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#ffffff"
            android:id="@+id/txtContent"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="150dp"/>
        <TextView
            android:textSize="13dp"
            android:textColor="#ffffff"
            android:id="@+id/txtPrivaceTips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="10dp"
            android:layout_marginBottom="5dp"
            android:text="请您阅读并同意《隐私政策》和《用户协议》"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/mar_privacy_lay"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp">
            <TextView
                android:textSize="13dp"
                android:textColor="#ffffff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="备案编号："/>
            <TextView
                android:textSize="13dp"
                android:textColor="#00bfff"
                android:id="@+id/mar_privacy_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="粤ICP备16040979号-11A"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_alignParentBottom="true">
            <Button
                android:textSize="13sp"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/btnClose"
                android:background="@drawable/mar_privacy_btn_close_bg"
                android:layout_width="70dp"
                android:layout_height="30dp"
                android:text="关闭"/>
            <Button
                android:textSize="13sp"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/txtderegister"
                android:background="@drawable/mar_privacy_btn_close_bg"
                android:visibility="gone"
                android:layout_width="70dp"
                android:layout_height="30dp"
                android:layout_marginLeft="20dp"
                android:text="注销账号"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

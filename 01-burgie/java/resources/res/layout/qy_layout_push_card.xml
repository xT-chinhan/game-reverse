<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/qy_reward_push_card"
    android:background="@drawable/qy_bg_corner15_solid_white"
    android:visibility="gone"
    android:layout_width="0dp"
    android:layout_height="63dp"
    android:layout_marginLeft="14dp"
    android:layout_marginTop="60dp"
    android:layout_marginRight="14dp"
    android:alpha="0"
    android:translationY="-70dp"
    app:layout_constraintLeft_toLeftOf="parent"
    app:layout_constraintRight_toRightOf="parent"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintWidth_max="500dp">
    <com.mcto.sspsdk.component.imageview.QYNiceImageView
        android:id="@+id/qy_reward_push_card_icon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginLeft="16dp"
        android:src="@drawable/qy_lg_gift_box_big_2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14dp"
        android:textStyle="bold"
        android:textColor="#000"
        android:gravity="bottom"
        android:id="@+id/qy_reward_push_card_title"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="7.5dp"
        android:layout_marginRight="90dp"
        android:maxEms="8"
        android:singleLine="true"
        app:layout_constraintBottom_toTopOf="@+id/qy_reward_push_card_sub_title"
        app:layout_constraintLeft_toRightOf="@+id/qy_reward_push_card_icon"
        app:layout_constraintRight_toLeftOf="@+id/qy_reward_push_card_time"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="12dp"
        android:textStyle="bold"
        android:textColor="@color/qy_text_color_black_50alpha"
        android:gravity="top"
        android:id="@+id/qy_reward_push_card_sub_title"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginRight="7.6dp"
        android:singleLine="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="@+id/qy_reward_push_card_title"
        app:layout_constraintRight_toLeftOf="@+id/qy_reward_push_card_time"
        app:layout_constraintTop_toBottomOf="@+id/qy_reward_push_card_title"/>
    <TextView
        android:textSize="12dp"
        android:textStyle="bold"
        android:textColor="@color/qy_text_color_black_50alpha"
        android:id="@+id/qy_reward_push_card_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginRight="16dp"
        android:text="刚刚"
        app:layout_constraintLeft_toRightOf="@+id/qy_reward_push_card_title"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/qy_reward_push_card_line"
        android:background="@drawable/qy_bg_corner30_solid_grey"
        android:layout_width="45dp"
        android:layout_height="2.5dp"
        android:layout_marginBottom="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
</android.support.constraint.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <View
        android:id="@+id/qy_reward_interactive_background"
        android:layout_width="283dp"
        android:layout_height="240dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/qy_reward_interactive_gold"
        android:layout_width="107.5dp"
        android:layout_height="107.5dp"
        android:src="@drawable/qy_ic_gold_group"
        android:translationY="-67.5dp"
        app:layout_constraintLeft_toLeftOf="@+id/qy_reward_interactive_background"
        app:layout_constraintTop_toTopOf="@+id/qy_reward_interactive_info_card"/>
    <TextView
        android:textSize="32dp"
        android:textStyle="bold"
        android:textColor="@color/qy_vip_button_bg"
        android:gravity="center"
        android:id="@+id/qy_reward_interactive_desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="恭喜获得\10金币奖励"
        android:includeFontPadding="false"
        android:lineSpacingExtra="-6dp"
        app:layout_constraintLeft_toLeftOf="@+id/qy_reward_interactive_background"
        app:layout_constraintRight_toRightOf="@+id/qy_reward_interactive_background"
        app:layout_constraintTop_toTopOf="@+id/qy_reward_interactive_background"/>
    <View
        android:id="@+id/qy_reward_interactive_info_card"
        android:background="@drawable/qy_bg_corners35_gradient_gold"
        android:layout_width="0dp"
        android:layout_height="150dp"
        app:layout_constraintBottom_toBottomOf="@+id/qy_reward_interactive_background"
        app:layout_constraintLeft_toLeftOf="@+id/qy_reward_interactive_background"
        app:layout_constraintRight_toRightOf="@+id/qy_reward_interactive_background"/>
    <TextView
        android:textSize="18dp"
        android:textStyle="bold"
        android:textColor="#ff0012"
        android:gravity="center"
        android:id="@+id/qy_reward_interactive_countdown"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="21.5dp"
        android:text="00:00"
        android:singleLine="true"
        android:includeFontPadding="false"
        app:layout_constraintLeft_toLeftOf="@+id/qy_reward_interactive_info_card"
        app:layout_constraintRight_toRightOf="@+id/qy_reward_interactive_info_card"
        app:layout_constraintTop_toTopOf="@+id/qy_reward_interactive_info_card"/>
    <TextView
        android:textSize="16dp"
        android:textStyle="bold"
        android:textColor="@color/qy_vip_text_color"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/qy_reward_interactive_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="点击浏览广告领金币"
        android:singleLine="true"
        android:includeFontPadding="false"
        app:layout_constraintLeft_toLeftOf="@+id/qy_reward_interactive_background"
        app:layout_constraintRight_toRightOf="@+id/qy_reward_interactive_background"
        app:layout_constraintTop_toBottomOf="@+id/qy_reward_interactive_countdown"
        app:layout_goneMarginTop="30dp"/>
    <TextView
        android:textSize="17dp"
        android:textColor="#fff"
        android:gravity="center"
        android:id="@+id/qy_reward_interactive_button"
        android:background="@drawable/qy_gradient_corners_vip_btn"
        android:layout_width="251dp"
        android:layout_height="40dp"
        android:layout_marginTop="17.5dp"
        android:text="领取金币奖励"
        android:singleLine="true"
        android:includeFontPadding="false"
        app:layout_constraintLeft_toLeftOf="@+id/qy_reward_interactive_background"
        app:layout_constraintRight_toRightOf="@+id/qy_reward_interactive_background"
        app:layout_constraintTop_toBottomOf="@+id/qy_reward_interactive_title"/>
</merge>

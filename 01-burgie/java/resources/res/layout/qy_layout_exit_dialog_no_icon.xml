<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <android.support.constraint.ConstraintLayout
        android:id="@+id/qy_exit_dialog_background"
        android:background="@drawable/qy_bg_corner15_solid_white"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_min="314dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_min="266dp">
        <TextView
            android:textSize="18dp"
            android:textStyle="bold"
            android:textColor="#161823"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/qy_dialog_msg"
            android:layout_width="234dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/qy_reward_exit_dialog_title"
            android:maxLines="2"
            android:fontFamily="sans-serif-medium"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/qy_dialog_img"
            android:layout_width="146dp"
            android:layout_height="102.5dp"
            android:layout_marginTop="16dp"
            android:src="@drawable/qy_lg_gift_box_big"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/qy_dialog_msg"/>
        <TextView
            android:textSize="18dp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/qy_dialog_positive_btn"
            android:background="@drawable/qy_gradient_corners_red_btn"
            android:layout_width="208dp"
            android:layout_height="49dp"
            android:layout_marginTop="13dp"
            android:text="@string/qy_reward_exit_dialog_positive_title"
            android:singleLine="true"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/qy_dialog_img"/>
        <TextView
            android:textSize="18dp"
            android:textColor="#fe2c55"
            android:gravity="center"
            android:id="@+id/qy_dialog_negative_btn"
            android:background="@drawable/qy_bg_stroke_red_btn"
            android:layout_width="208dp"
            android:layout_height="49dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="26dp"
            android:text="@string/qy_reward_exit_dialog_negative_title"
            android:singleLine="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/qy_dialog_positive_btn"/>
    </android.support.constraint.ConstraintLayout>
</android.support.constraint.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:id="@+id/interstitial_half_landscape_inner"
    android:background="@drawable/tapad_bg_white_radius_8dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.tapsdk.tapad.internal.ui.views.HotZoneFrameLayout
        android:id="@+id/hotZoneFrameLayout"
        android:background="@drawable/tapad_bg_white_radius_8dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="16dp"
            android:textStyle="bold"
            android:textColor="#52575d"
            android:ellipsize="end"
            android:id="@+id/bottomSquareBannerDescriptionTextView"
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:maxLines="1"
            android:lines="1"
            android:singleLine="true"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="26dp"
            android:layout_alignStart="@+id/adCoverImage"
            android:layout_alignEnd="@+id/adCoverImage"/>
        <ImageView
            android:id="@+id/adCoverImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="38dp"
            android:layout_marginBottom="26dp"
            android:scaleType="fitXY"
            android:adjustViewBounds="true"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/video_surface"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="38dp"
            android:layout_marginBottom="26dp"
            android:scaleType="fitXY"
            android:adjustViewBounds="true"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <com.tapsdk.tapad.internal.ui.views.video.VideoSurfaceView
                    android:id="@+id/adsSurfaceView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"/>
                <ImageView
                    android:id="@+id/volumeImageView"
                    android:background="@drawable/tapad_bg_mediaplayer_audio"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginTop="5dp"
                    android:src="@drawable/tapad_ic_audio_open"
                    android:scaleType="centerInside"
                    android:layout_marginStart="5dp"/>
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/mediaPlayerImageView"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:src="@drawable/tapad_ic_media_play"
                    android:scaleType="center"/>
                <LinearLayout
                    android:layout_gravity="end"
                    android:orientation="horizontal"
                    android:id="@+id/rewardSkipLinearLayout"
                    android:background="@drawable/tapad_bg_reward_round_corner18dp"
                    android:layout_width="82dp"
                    android:layout_height="30dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginEnd="8dp">
                    <TextView
                        android:textSize="13dp"
                        android:textStyle="bold"
                        android:textColor="@android:color/white"
                        android:gravity="center"
                        android:id="@+id/countDownTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:text="5秒"
                        android:lines="1"
                        android:singleLine="true"
                        android:layout_weight="1"
                        android:layout_marginStart="2dp"/>
                    <View
                        android:layout_gravity="center"
                        android:id="@+id/skipDividerView"
                        android:background="#33ffffff"
                        android:layout_width="1dp"
                        android:layout_height="match_parent"/>
                    <TextView
                        android:textSize="13dp"
                        android:textStyle="bold"
                        android:textColor="@android:color/white"
                        android:gravity="center"
                        android:id="@+id/skipTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:text="跳过"
                        android:lines="1"
                        android:singleLine="true"
                        android:layout_weight="1"
                        android:layout_marginEnd="2dp"/>
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </RelativeLayout>
    <RelativeLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="40dp"
        android:layout_marginBottom="38dp"
        android:layout_centerVertical="true"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp">
        <FrameLayout
            android:id="@+id/bottomSquareBannerInteractionFrameLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            android:translationY="70dp"
            android:layout_marginEnd="6dp">
            <FrameLayout
                android:layout_gravity="center"
                android:id="@+id/bottomSquareBannerDownloadFrameLayout"
                android:background="@drawable/tapad_bg_progress_outer_radius24"
                android:visibility="visible"
                android:layout_width="170dp"
                android:layout_height="32dp">
                <ProgressBar
                    android:layout_gravity="center"
                    android:id="@+id/bottomSquareBannerDownloadProgressBar"
                    android:layout_width="170dp"
                    android:layout_height="10dp"
                    android:progress="60"
                    style="@style/tapad_download_progress_green"/>
            </FrameLayout>
            <TextView
                android:textSize="13dp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/bottomSquareBannerInteractionTextView"
                android:background="@drawable/tapad_bg_reward_button_green_corner16dp"
                android:layout_width="170dp"
                android:layout_height="32dp"/>
        </FrameLayout>
    </RelativeLayout>
    <include layout="@layout/tapad_footer"/>
</RelativeLayout>

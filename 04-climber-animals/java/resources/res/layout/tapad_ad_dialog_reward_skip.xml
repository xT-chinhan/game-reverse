<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#ffffff"
    android:paddingTop="40dp"
    android:paddingBottom="20dp"
    android:layout_width="300dp"
    android:layout_height="336dp"
    android:paddingStart="20dp"
    android:paddingEnd="20dp">
    <ImageView
        android:layout_gravity="center_horizontal"
        android:layout_width="75dp"
        android:layout_height="74dp"
        android:src="@drawable/tapad_ic_reward_gift"
        android:scaleType="fitCenter"/>
    <TextView
        android:textSize="16dp"
        android:textColor="#52575d"
        android:gravity="center_horizontal"
        android:id="@+id/rewardHintTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:lines="1"
        android:singleLine="true"/>
    <TextView
        android:textSize="14dp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/resumePlayAdTextView"
        android:background="@drawable/tapad_alert_positive_bg"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="30dp"
        android:text="@string/tapad_btn_resume_play"/>
    <TextView
        android:textSize="14dp"
        android:textColor="#868c92"
        android:gravity="center"
        android:id="@+id/abortRewardTextView"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="12dp"
        android:text="@string/tapad_btn_abort_reward"/>
</LinearLayout>

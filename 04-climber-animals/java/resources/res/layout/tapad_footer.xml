<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:id="@+id/bannerFooterRelativeLayout"
    android:layout_width="match_parent"
    android:layout_height="18dp"
    android:layout_marginBottom="9dp"
    android:layout_alignParentBottom="true"
    android:layout_marginStart="10dp"
    android:layout_marginEnd="10dp">
    <LinearLayout
        android:id="@+id/versionAndSupplierLinearLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toStartOf="@+id/privacyLinearLayout">
        <TextView
            android:textSize="10dp"
            android:textColor="#b9bec1"
            android:ellipsize="end"
            android:id="@+id/privacyVersionTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="版本 1.13.0"
            android:lines="1"
            android:singleLine="true"
            android:maxLength="11"/>
        <TextView
            android:textSize="10dp"
            android:textColor="#b9bec1"
            android:ellipsize="end"
            android:id="@+id/supplierTextView"
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:text="北京安石科技有限公司"
            android:lines="1"
            android:singleLine="true"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/privacyLinearLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_alignParentEnd="true">
        <TextView
            android:textSize="10dp"
            android:textColor="#b9bec1"
            android:id="@+id/describeTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="详情"
            android:layout_weight="1"/>
        <TextView
            android:textSize="10dp"
            android:textColor="#b9bec1"
            android:id="@+id/privacyTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="隐私"
            android:layout_weight="1"
            android:layout_marginStart="8dp"/>
        <TextView
            android:textSize="10dp"
            android:textColor="#b9bec1"
            android:id="@+id/permissionTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="权限"
            android:layout_weight="1"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
</RelativeLayout>

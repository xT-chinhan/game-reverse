<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/tapad_bg_white_radius_8dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.tapsdk.tapad.internal.ui.views.HotZoneFrameLayout
        android:id="@+id/hotZoneFrameLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="30dp"
        android:layout_marginBottom="30dp"
        android:layout_centerVertical="true"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/bottomSquareBannerIconImageView"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:scaleType="fitXY"
            android:adjustViewBounds="true"/>
        <TextView
            android:textSize="16dp"
            android:textStyle="bold"
            android:textColor="#1d2127"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/bottomSquareBannerTitleTextView"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:layout_marginTop="6dp"
            android:maxLines="1"
            android:lines="1"
            android:singleLine="true"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"/>
        <RelativeLayout
            android:gravity="center_horizontal"
            android:id="@+id/bottomSquareBannerScoreRelativeLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp">
            <LinearLayout
                android:gravity="center"
                android:id="@+id/tapad_ic_logo_review"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_centerHorizontal="true">
                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="12dp"
                    android:src="@drawable/tapad_ic_taptap_green_small"
                    android:scaleType="centerInside"/>
                <TextView
                    android:textSize="12dp"
                    android:textStyle="bold"
                    android:textColor="#15c5ce"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="评分"
                    android:layout_marginStart="2dp"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="14dp"
                android:layout_marginTop="4dp"
                android:layout_toRightOf="@+id/tapad_ic_logo_review">
                <ImageView
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginTop="4dp"
                    android:src="@drawable/tapad_ic_star_mini"
                    android:layout_marginStart="4dp"/>
                <TextView
                    android:textSize="12dp"
                    android:textStyle="bold"
                    android:textColor="#15c5ce"
                    android:id="@+id/bottomSquareBannerRealScoreTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:layout_marginStart="1dp"/>
            </LinearLayout>
        </RelativeLayout>
        <TextView
            android:textSize="12dp"
            android:textStyle="bold"
            android:textColor="#52575d"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/bottomSquareBannerDescriptionTextView"
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"
            android:maxLines="1"
            android:lines="1"
            android:singleLine="true"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/adCoverImage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:scaleType="fitXY"
            android:adjustViewBounds="true"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"/>
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="vertical"
            android:id="@+id/video_surface"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <com.tapsdk.tapad.internal.ui.views.video.VideoSurfaceView
                    android:id="@+id/adsSurfaceView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"/>
                <ImageView
                    android:id="@+id/volumeImageView"
                    android:background="@drawable/tapad_bg_mediaplayer_audio"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginTop="5dp"
                    android:src="@drawable/tapad_ic_audio_open"
                    android:scaleType="centerInside"
                    android:layout_marginStart="5dp"/>
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/mediaPlayerImageView"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:src="@drawable/tapad_ic_media_play"
                    android:scaleType="center"/>
                <LinearLayout
                    android:layout_gravity="end"
                    android:orientation="horizontal"
                    android:id="@+id/rewardSkipLinearLayout"
                    android:background="@drawable/tapad_bg_reward_round_corner18dp"
                    android:layout_width="62dp"
                    android:layout_height="20dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginEnd="8dp">
                    <TextView
                        android:textSize="11dp"
                        android:textStyle="bold"
                        android:textColor="@android:color/white"
                        android:gravity="center"
                        android:id="@+id/countDownTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="20dp"
                        android:text="5秒"
                        android:lines="1"
                        android:singleLine="true"
                        android:layout_weight="1"
                        android:layout_marginStart="2dp"/>
                    <View
                        android:layout_gravity="center"
                        android:id="@+id/skipDividerView"
                        android:background="#33ffffff"
                        android:layout_width="1dp"
                        android:layout_height="match_parent"/>
                    <TextView
                        android:textSize="11dp"
                        android:textStyle="bold"
                        android:textColor="@android:color/white"
                        android:gravity="center"
                        android:id="@+id/skipTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="20dp"
                        android:text="跳过"
                        android:lines="1"
                        android:singleLine="true"
                        android:layout_weight="1"
                        android:layout_marginEnd="2dp"/>
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
        <FrameLayout
            android:layout_gravity="center"
            android:id="@+id/bottomSquareBannerInteractionFrameLayout"
            android:layout_width="170dp"
            android:layout_height="32dp"
            android:layout_marginBottom="16dp">
            <FrameLayout
                android:layout_gravity="center"
                android:id="@+id/bottomSquareBannerDownloadFrameLayout"
                android:background="@drawable/tapad_bg_progress_outer_radius16"
                android:visibility="visible"
                android:layout_width="170dp"
                android:layout_height="32dp">
                <ProgressBar
                    android:layout_gravity="center"
                    android:id="@+id/bottomSquareBannerDownloadProgressBar"
                    android:layout_width="160dp"
                    android:layout_height="10dp"
                    android:progress="60"
                    style="@style/tapad_download_progress_green"/>
            </FrameLayout>
            <TextView
                android:textSize="13dp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:id="@+id/bottomSquareBannerInteractionTextView"
                android:background="@drawable/tapad_bg_reward_button_green_corner16dp"
                android:layout_width="170dp"
                android:layout_height="32dp"
                android:layout_marginBottom="16dp"/>
        </FrameLayout>
    </LinearLayout>
    <include layout="@layout/tapad_footer"/>
</RelativeLayout>

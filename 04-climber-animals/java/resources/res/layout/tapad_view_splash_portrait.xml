<?xml version="1.0" encoding="utf-8"?>
<com.tapsdk.tapad.internal.ui.views.PortraitSplashFixedAspectRatioFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/portraitSplashFixedAspectRatioFrameLayout"
    android:background="@android:color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:tapad_aspectRatioHeight="16"
    app:tapad_aspectRatioWidth="9">
    <ImageView
        android:id="@+id/portraitSplashBackgroundImageView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <RelativeLayout
        android:id="@+id/portraitSplashAdsRelativeLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.tapsdk.tapad.internal.ui.views.video.VideoSurfaceView
            android:id="@+id/portraitSplashCoverSurfaceView"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"/>
        <ImageView
            android:id="@+id/portraitSplashCoverImageView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"/>
        <LinearLayout
            android:gravity="center"
            android:id="@+id/adLogoLinearLayout"
            android:background="@drawable/tapad_bg_tap_logo_corner2dp"
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:layout_marginTop="32dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:layout_marginStart="16dp">
            <ImageView
                android:id="@+id/adLogoImageView"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:src="@drawable/tapad_ic_lava_mini"
                android:scaleType="centerInside"/>
            <TextView
                android:textSize="10dp"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:id="@+id/adLogoTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lines="1"
                android:singleLine="true"/>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/portraitSplashSkipFrameLayout"
            android:background="@drawable/tapad_bg_reward_round_corner18dp"
            android:layout_width="102dp"
            android:layout_height="36dp"
            android:layout_marginTop="32dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:layout_marginEnd="16dp"
            android:layout_alignParentEnd="true">
            <TextView
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:id="@+id/portraitSplashCountDownTextView"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:lines="1"
                android:singleLine="true"/>
            <View
                android:layout_gravity="center"
                android:background="#33ffffff"
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="-1dp"
                android:layout_marginTop="9dp"
                android:layout_marginBottom="9dp"/>
            <TextView
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/skipTextView"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/tapad_btn_skip"
                android:lines="1"
                android:singleLine="true"/>
        </FrameLayout>
        <com.tapsdk.tapad.internal.ui.views.HotZoneFrameLayout
            android:id="@+id/hotZoneFrameLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="200dp"
            android:layout_marginBottom="-2dp"
            android:layout_alignParentBottom="true"/>
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true">
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/shakeViewContainer"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true">
                <com.tapsdk.tapad.internal.animation.ShakeAnimationView
                    android:id="@+id/shakeImageView"
                    android:layout_width="72dp"
                    android:layout_height="80dp"/>
                <TextView
                    android:textSize="18dp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:id="@+id/shakeTitleTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="摇一摇"/>
                <TextView
                    android:textSize="16dp"
                    android:textColor="@android:color/white"
                    android:id="@+id/shakeDescriptionTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="前往详情页或第三方应用"/>
            </LinearLayout>
            <FrameLayout
                android:id="@+id/portraitSplashInteractionFrameLayout"
                android:background="@drawable/tapad_bg_splash_button_gray_corner39dp"
                android:padding="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="16dp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:gravity="center"
                    android:id="@+id/portraitSplashInteractionTextView"
                    android:background="@drawable/tapad_bg_splash_button_green_corner25dp"
                    android:layout_width="295dp"
                    android:layout_height="50dp"/>
                <Button
                    android:textSize="16dp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:gravity="center"
                    android:id="@+id/portraitSplashDownloadBtn"
                    android:background="@drawable/tapad_bg_splash_button_green_corner25dp"
                    android:visibility="gone"
                    android:layout_width="295dp"
                    android:layout_height="50dp"/>
                <ProgressBar
                    android:gravity="center"
                    android:id="@+id/portraitSplashInteractionProgressBar"
                    android:background="@drawable/tapad_bg_splash_button_green_corner25dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:visibility="gone"
                    android:layout_width="295dp"
                    android:layout_height="50dp"
                    android:progress="60"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    style="@style/tapad_download_progress_white"/>
            </FrameLayout>
        </RelativeLayout>
    </RelativeLayout>
</com.tapsdk.tapad.internal.ui.views.PortraitSplashFixedAspectRatioFrameLayout>

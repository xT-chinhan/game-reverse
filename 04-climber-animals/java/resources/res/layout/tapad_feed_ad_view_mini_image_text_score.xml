<?xml version="1.0" encoding="utf-8"?>
<com.tapsdk.tapad.feed.TapFeedAdView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tapad_feed_ad_view_root"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">
    <RelativeLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include
            android:id="@+id/tapad_material_container"
            android:layout_width="128dp"
            android:layout_height="72dp"
            android:layout_marginEnd="12dp"
            layout="@layout/tapad_feed_material_container"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/tapad_text_description"
            android:ellipsize="end"
            android:id="@+id/tapad_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:maxLines="2"
            android:layout_toRightOf="@+id/tapad_material_container"
            android:layout_alignTop="@+id/tapad_material_container"
            android:layout_alignParentEnd="true"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/tapad_score_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toRightOf="@+id/tapad_material_container"
            android:layout_alignBottom="@+id/tapad_material_container"
            android:layout_alignParentEnd="true">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/tapad_ic_taptap_green_small"/>
            <TextView
                android:textSize="12dp"
                android:textStyle="bold"
                android:textColor="#15c5ce"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="评分"
                android:layout_marginStart="2dp"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/tapad_ic_star_mini"
                android:scaleType="centerInside"
                android:layout_marginStart="2dp"/>
            <TextView
                android:textSize="12dp"
                android:textStyle="bold"
                android:textColor="#15c5ce"
                android:id="@+id/tapad_score_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"/>
        </LinearLayout>
        <include
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_below="@+id/tapad_material_container"
            layout="@layout/tapad_feed_foot_logo_container"/>
    </RelativeLayout>
</com.tapsdk.tapad.feed.TapFeedAdView>

<?xml version="1.0" encoding="utf-8"?>
<com.tapsdk.tapad.feed.TapFeedAdView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tapad_feed_ad_view_root"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include
            android:id="@+id/tapad_material_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            layout="@layout/tapad_feed_material_container"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/tapad_app_container"
            android:background="@drawable/tapad_feed_float_background_gradient"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignBottom="@+id/tapad_material_container"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:layout_alignStart="@+id/tapad_material_container"
            android:layout_alignEnd="@+id/tapad_material_container">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/tapad_app_icon_image"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/tapad_app_icon_default"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp">
                <TextView
                    android:textSize="16dp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:id="@+id/tapad_app_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"/>
                <TextView
                    android:textSize="13dp"
                    android:textColor="@android:color/white"
                    android:ellipsize="end"
                    android:id="@+id/tapad_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"/>
            </LinearLayout>
        </LinearLayout>
        <include
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/tapad_material_container"
            layout="@layout/tapad_feed_foot_logo_container"/>
    </RelativeLayout>
</com.tapsdk.tapad.feed.TapFeedAdView>

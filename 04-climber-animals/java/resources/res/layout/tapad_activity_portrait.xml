<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@android:color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/backgroundImageView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <com.tapsdk.tapad.internal.ui.views.video.VideoSurfaceView
        android:id="@+id/adsSurfaceView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true"/>
    <ImageView
        android:id="@+id/coverImageView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageView
        android:id="@+id/mediaPlayerImageView"
        android:visibility="gone"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:src="@drawable/tapad_ic_media_play"
        android:scaleType="center"
        android:layout_centerInParent="true"/>
    <include layout="@layout/tapad_view_reward_complete_portrait"/>
    <ImageView
        android:id="@+id/volumeImageView"
        android:background="@drawable/tapad_bg_mediaplayer_audio"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginTop="44dp"
        android:src="@drawable/tapad_ic_audio_open"
        android:scaleType="centerInside"
        android:layout_marginStart="16dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/rewardSkipLinearLayout"
        android:background="@drawable/tapad_bg_reward_round_corner18dp"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginTop="44dp"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:layout_marginEnd="16dp"
        android:layout_alignParentEnd="true">
        <TextView
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/countDownTextView"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:lines="1"
            android:singleLine="true"/>
        <View
            android:layout_gravity="center"
            android:id="@+id/skipDividerView"
            android:background="#33ffffff"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginTop="9dp"
            android:layout_marginBottom="9dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"/>
        <TextView
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/skipTextView"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="@string/tapad_btn_skip"
            android:lines="1"
            android:singleLine="true"/>
    </LinearLayout>
    <include
        android:id="@+id/bubbleView"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="178dp"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="8dp"
        android:layout_alignParentEnd="true"
        layout="@layout/tapad_wait_bubble"/>
    <com.tapsdk.tapad.internal.ui.views.banner.PortraitBannerView
        android:id="@+id/portraitBannerView"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_marginBottom="8dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"/>
    <com.tapsdk.tapad.internal.ui.views.banner.PortraitBannerWithoutTagView
        android:id="@+id/portraitBannerWithoutTagView"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_marginBottom="8dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"/>
</RelativeLayout>

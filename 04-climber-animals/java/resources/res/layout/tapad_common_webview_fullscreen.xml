<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:background="@android:color/white"
        android:layout_width="match_parent"
        android:layout_height="48dp">
        <ImageView
            android:id="@+id/webBackImageView"
            android:layout_width="60dp"
            android:layout_height="match_parent"
            android:src="@drawable/tapad_ic_back"
            android:scaleType="center"
            android:paddingStart="10dp"
            android:paddingEnd="20dp"/>
        <View
            android:background="#ebeff0"
            android:layout_width="match_parent"
            android:layout_height="1.5px"
            android:layout_alignParentBottom="true"/>
        <ImageView
            android:id="@+id/webCloseImageView"
            android:layout_width="60dp"
            android:layout_height="match_parent"
            android:src="@drawable/tapad_ic_close"
            android:scaleType="center"
            android:layout_alignParentRight="true"
            android:paddingStart="20dp"
            android:paddingEnd="10dp"/>
    </RelativeLayout>
    <com.tapsdk.tapad.internal.ui.views.web.ADWebView
        android:id="@+id/containerWebView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</LinearLayout>

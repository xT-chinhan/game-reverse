<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/tapad_wait_bubble_background"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/icon_image"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:src="@drawable/tapad_bubble_default"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_alignParentStart="true"/>
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/content_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toRightOf="@+id/icon_image"
        android:layout_centerVertical="true">
        <TextView
            android:textSize="14dp"
            android:textColor="@color/tapad_popup_color_white"
            android:ellipsize="end"
            android:id="@+id/content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:maxWidth="160dp"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#b3ffffff"
            android:id="@+id/description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="180dp"/>
    </LinearLayout>
    <Button
        android:textSize="10dp"
        android:textColor="#b3ffffff"
        android:layout_gravity="center_vertical"
        android:id="@+id/close_btn"
        android:background="@drawable/tapad_wait_bubble_button_background"
        android:visibility="visible"
        android:layout_width="38dp"
        android:layout_height="18dp"
        android:text="不用了"
        android:layout_toRightOf="@+id/content_layout"
        android:layout_centerVertical="true"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"/>
</RelativeLayout>

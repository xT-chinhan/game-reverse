<?xml version="1.0" encoding="utf-8"?>
<com.tapsdk.tapad.feed.TapFeedAdView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tapad_feed_ad_view_root"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">
    <RelativeLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="72dp">
        <TextView
            android:textSize="14dp"
            android:textColor="@color/tapad_text_description"
            android:ellipsize="end"
            android:id="@+id/tapad_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:maxLines="2"
            android:layout_toStartOf="@+id/tapad_material_container"/>
        <include
            android:id="@+id/tapad_material_container"
            android:layout_width="128dp"
            android:layout_height="72dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="12dp"
            android:layout_alignParentEnd="true"
            layout="@layout/tapad_feed_material_container"/>
        <include
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignBottom="@+id/tapad_material_container"
            android:layout_toStartOf="@+id/tapad_material_container"
            layout="@layout/tapad_feed_foot_logo_container"/>
    </RelativeLayout>
</com.tapsdk.tapad.feed.TapFeedAdView>

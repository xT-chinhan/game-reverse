<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/landscapeAdsRelativeLayout"
    android:background="@android:color/white"
    android:layout_width="match_parent"
    android:layout_height="82dp">
    <LinearLayout
        android:gravity="center"
        android:id="@+id/landscapeBannerAdLogoLinearLayout"
        android:background="@drawable/tapad_bg_tap_logo_corner2dp_bottom_right"
        android:layout_width="wrap_content"
        android:layout_height="12dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">
        <ImageView
            android:id="@+id/landscapeBannerAdLogoImageView"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@drawable/tapad_ic_lava_mini"
            android:scaleType="centerInside"/>
        <TextView
            android:textSize="8dp"
            android:textColor="@android:color/white"
            android:id="@+id/landscapeBannerAdLogoTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="广告"/>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/landscapeAdsMasterRelativeLayout"
        android:layout_width="match_parent"
        android:layout_height="99dp">
        <com.tapsdk.tapad.internal.ui.views.HotZoneFrameLayout
            android:id="@+id/landscapeBannerAdHotZoneFrameLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ImageView
            android:id="@+id/landscapeIconImageView"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="16dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/landscapeInteractionFrameLayout"
            android:layout_toEndOf="@+id/landscapeIconImageView">
            <LinearLayout
                android:gravity="bottom"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="16dp"
                    android:textColor="#1d2127"
                    android:ellipsize="end"
                    android:id="@+id/landscapeTitleTextView"
                    android:padding="1dp"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:lines="1"
                    android:singleLine="true"
                    android:layout_marginStart="8dp"/>
                <com.tapsdk.tapad.internal.ui.views.TagView
                    android:id="@+id/tagView"
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:layout_marginBottom="2dp"
                    android:lines="1"
                    android:layout_marginStart="8dp">
                    <LinearLayout
                        android:gravity="center_horizontal"
                        android:layout_gravity="center"
                        android:id="@+id/firstTag"
                        android:background="@drawable/tapad_bg_tag_outer_radius4"
                        android:layout_width="wrap_content"
                        android:layout_height="20dp">
                        <ImageView
                            android:layout_gravity="center"
                            android:background="@drawable/tapad_img"
                            android:layout_width="16dp"
                            android:layout_height="16dp"/>
                    </LinearLayout>
                </com.tapsdk.tapad.internal.ui.views.TagView>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp">
                <RelativeLayout
                    android:id="@+id/landscapeScoreRelativeLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp">
                    <ImageView
                        android:id="@+id/tapLogoImageView"
                        android:layout_width="44dp"
                        android:layout_height="12dp"
                        android:src="@drawable/tapad_ic_taptap_green_small"
                        android:scaleType="centerInside"
                        android:layout_centerVertical="true"/>
                    <TextView
                        android:textSize="12dp"
                        android:textStyle="bold"
                        android:textColor="#15c5ce"
                        android:id="@+id/scoreTitleTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="评分"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="2dp"
                        android:layout_toEndOf="@+id/tapLogoImageView"/>
                    <ImageView
                        android:id="@+id/starImageView"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:src="@drawable/tapad_ic_star_mini"
                        android:scaleType="centerInside"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="2dp"
                        android:layout_toEndOf="@+id/scoreTitleTextView"/>
                    <TextView
                        android:textSize="12dp"
                        android:textStyle="bold"
                        android:textColor="#15c5ce"
                        android:id="@+id/landscapeRealScoreTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:lines="1"
                        android:singleLine="true"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="2dp"
                        android:layout_toEndOf="@+id/starImageView"/>
                </RelativeLayout>
                <TextView
                    android:textSize="12dp"
                    android:textColor="#868c92"
                    android:ellipsize="end"
                    android:id="@+id/landscapeDescriptionTextView"
                    android:layout_width="match_parent"
                    android:layout_height="18dp"
                    android:lines="1"
                    android:singleLine="true"/>
            </LinearLayout>
            <include layout="@layout/tapad_footer"/>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/landscapeInteractionFrameLayout"
            android:layout_width="112dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="16dp"
            android:layout_alignParentEnd="true">
            <FrameLayout
                android:id="@+id/landscapeDownloadFrameLayout"
                android:background="@drawable/tapad_bg_progress_outer_radius20"
                android:visibility="gone"
                android:layout_width="112dp"
                android:layout_height="40dp">
                <ProgressBar
                    android:layout_gravity="center"
                    android:id="@+id/landscapeDownloadProgressBar"
                    android:layout_width="88dp"
                    android:layout_height="10dp"
                    android:progress="60"
                    style="@style/tapad_download_progress_green"/>
            </FrameLayout>
            <TextView
                android:textSize="14dp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/landscapeInteractionTextView"
                android:background="@drawable/tapad_bg_reward_button_green_corner24dp"
                android:layout_width="match_parent"
                android:layout_height="40dp"/>
        </FrameLayout>
    </RelativeLayout>
    <ImageView
        android:id="@+id/landscapeCloseBannerImageView"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/tapad_ic_banner_close"
        android:scaleType="center"
        android:layout_alignParentRight="true"/>
</RelativeLayout>

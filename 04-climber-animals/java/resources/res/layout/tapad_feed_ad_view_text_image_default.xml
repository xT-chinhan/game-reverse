<?xml version="1.0" encoding="utf-8"?>
<com.tapsdk.tapad.feed.TapFeedAdView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tapad_feed_ad_view_root"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="16dp"
            android:textColor="@color/tapad_text_description"
            android:id="@+id/tapad_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_alignParentStart="true"/>
        <include
            android:id="@+id/tapad_material_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="6dp"
            android:layout_below="@+id/tapad_description"
            layout="@layout/tapad_feed_material_container"/>
        <include
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/tapad_material_container"
            layout="@layout/tapad_feed_foot_logo_container"/>
    </RelativeLayout>
</com.tapsdk.tapad.feed.TapFeedAdView>

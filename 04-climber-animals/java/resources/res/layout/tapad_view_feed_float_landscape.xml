<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rightSquareBannerAdsRelativeLayout"
    android:background="@android:color/white"
    android:layout_width="wrap_content"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/rightBannerMasterLinearLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="38dp"
        android:layout_marginBottom="38dp"
        android:layout_centerInParent="true"
        android:layout_centerVertical="true"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/rightSquareBannerIconImageView"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginStart="6dp"/>
        <TextView
            android:textSize="20dp"
            android:textColor="#1d2127"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/rightSquareBannerTitleTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lines="1"
            android:singleLine="true"
            android:layout_marginEnd="6dp"/>
        <TextView
            android:textSize="16dp"
            android:textColor="#868c92"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/rightSquareBannerDescriptionTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:lines="2"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"/>
        <RelativeLayout
            android:layout_gravity="center_horizontal"
            android:id="@+id/rightSquareBannerScoreRelativeLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="32dp"
                android:textStyle="bold"
                android:textColor="#15c5ce"
                android:id="@+id/rightSquareBannerRealScoreTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_marginStart="2dp"/>
            <LinearLayout
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_below="@+id/rightSquareBannerRealScoreTextView"
                android:layout_centerHorizontal="true">
                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="12dp"
                    android:src="@drawable/tapad_ic_taptap_green_small"
                    android:scaleType="centerInside"/>
                <TextView
                    android:textSize="12dp"
                    android:textStyle="bold"
                    android:textColor="#15c5ce"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="评分"
                    android:layout_marginStart="2dp"/>
            </LinearLayout>
        </RelativeLayout>
        <FrameLayout
            android:id="@+id/rightSquareBannerInteractionFrameLayout"
            android:layout_width="match_parent"
            android:layout_height="49dp"
            android:layout_marginTop="19dp">
            <FrameLayout
                android:layout_gravity="center"
                android:id="@+id/rightSquareBannerDownloadFrameLayout"
                android:background="@drawable/tapad_bg_progress_outer_radius24"
                android:visibility="gone"
                android:layout_width="256dp"
                android:layout_height="48dp">
                <ProgressBar
                    android:layout_gravity="center"
                    android:id="@+id/rightSquareBannerDownloadProgressBar"
                    android:layout_width="232dp"
                    android:layout_height="10dp"
                    android:progress="60"
                    style="@style/tapad_download_progress_green"/>
            </FrameLayout>
            <TextView
                android:textSize="16dp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/rightSquareBannerInteractionTextView"
                android:background="@drawable/tapad_bg_reward_button_green_corner24dp"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"/>
        </FrameLayout>
    </LinearLayout>
    <include layout="@layout/tapad_footer"/>
</RelativeLayout>

<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bottomSquareBannerRelativeLayout"
    android:background="@android:color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:id="@+id/bottomSquareBannerAdLogoLinearLayout"
        android:background="@drawable/tapad_bg_tap_logo_corner2dp_bottom_right"
        android:layout_width="wrap_content"
        android:layout_height="12dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">
        <ImageView
            android:id="@+id/bottomSquareBannerAdLogoImageView"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@drawable/tapad_ic_lava_mini"
            android:scaleType="centerInside"/>
        <TextView
            android:textSize="8dp"
            android:textColor="@android:color/white"
            android:id="@+id/bottomSquareBannerAdLogoTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="40dp"
        android:layout_marginBottom="38dp"
        android:layout_centerVertical="true"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/bottomSquareBannerIconImageView"
            android:layout_width="64dp"
            android:layout_height="64dp"/>
        <TextView
            android:textSize="20dp"
            android:textColor="#1d2127"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/bottomSquareBannerTitleTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lines="1"
            android:singleLine="true"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"/>
        <TextView
            android:textSize="16dp"
            android:textColor="#868c92"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/bottomSquareBannerDescriptionTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:lines="2"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"/>
        <RelativeLayout
            android:id="@+id/bottomSquareBannerScoreRelativeLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp">
            <TextView
                android:textSize="32dp"
                android:textStyle="bold"
                android:textColor="#15c5ce"
                android:id="@+id/bottomSquareBannerRealScoreTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_marginStart="2dp"/>
            <LinearLayout
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_below="@+id/bottomSquareBannerRealScoreTextView"
                android:layout_centerHorizontal="true">
                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="12dp"
                    android:src="@drawable/tapad_ic_taptap_green_small"
                    android:scaleType="centerInside"/>
                <TextView
                    android:textSize="12dp"
                    android:textStyle="bold"
                    android:textColor="#15c5ce"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="评分"
                    android:layout_marginStart="2dp"/>
            </LinearLayout>
        </RelativeLayout>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/interstitialAdImage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="40dp"
            android:layout_marginEnd="40dp"/>
        <FrameLayout
            android:id="@+id/bottomSquareBannerInteractionFrameLayout"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="19dp">
            <FrameLayout
                android:layout_gravity="center"
                android:id="@+id/bottomSquareBannerDownloadFrameLayout"
                android:background="@drawable/tapad_bg_progress_outer_radius24"
                android:visibility="visible"
                android:layout_width="256dp"
                android:layout_height="48dp">
                <ProgressBar
                    android:layout_gravity="center"
                    android:id="@+id/bottomSquareBannerDownloadProgressBar"
                    android:layout_width="232dp"
                    android:layout_height="10dp"
                    android:progress="60"
                    style="@style/tapad_download_progress_green"/>
            </FrameLayout>
            <TextView
                android:textSize="16dp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/bottomSquareBannerInteractionTextView"
                android:background="@drawable/tapad_bg_reward_button_green_corner24dp"
                android:layout_width="256dp"
                android:layout_height="48dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"/>
        </FrameLayout>
    </LinearLayout>
    <RelativeLayout
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="18dp"
        android:layout_marginBottom="9dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp">
        <TextView
            android:textSize="12dp"
            android:textColor="#b9bec1"
            android:id="@+id/bottomSquareBannerPrivacyVersionTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="版本 1.13.0"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#b9bec1"
            android:ellipsize="end"
            android:id="@+id/bottomSquareBannerSupplierTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="北京安石科技有限公司"
            android:lines="1"
            android:layout_marginStart="8dp"
            android:layout_toStartOf="@+id/privacyLinearLayout"
            android:layout_toEndOf="@+id/bottomSquareBannerPrivacyVersionTextView"/>
        <LinearLayout
            android:id="@+id/privacyLinearLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_alignParentEnd="true">
            <TextView
                android:textSize="12dp"
                android:textColor="#b9bec1"
                android:id="@+id/privacyTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="隐私"
                android:layout_weight="1"/>
            <TextView
                android:textSize="12dp"
                android:textColor="#b9bec1"
                android:id="@+id/permissionTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="权限"
                android:layout_weight="1"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="70dp">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/download_state_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/tapad_webview_downloading_icon"
        android:layout_marginStart="13dp"
        android:layout_marginEnd="13dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginTop="15dp"
        android:layout_weight="1">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">
            <TextView
                android:textSize="14dp"
                android:ellipsize="middle"
                android:id="@+id/download_file_name_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_toStartOf="@+id/download_file_size_text"/>
            <TextView
                android:textSize="12dp"
                android:id="@+id/download_file_size_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <ProgressBar
            android:id="@+id/download_progress"
            android:layout_width="match_parent"
            android:layout_height="11dp"
            android:progress="0"
            style="@style/tapad_download_progress_green"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/download_close_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:src="@drawable/tapad_ic_close"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="8dp"/>
</LinearLayout>
